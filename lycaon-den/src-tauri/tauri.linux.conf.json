{
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Painted Wolf Code",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb"],
    "createUpdaterArtifacts": false,
    "externalBin": [],
    "resources": {
      "engine-root/": null,
      "THIRD-PARTY-NOTICES.md": null,
      "../../VERSION": null
    },
    "category": "DeveloperTool",
    "publisher": "Painted Wolf release <release-bot@users.noreply.github.com>",
    "homepage": "https://paintedwolf.ai",
    "license": "Apache-2.0",
    "shortDescription": "Agentic coding assistant with a local security engine",
    "longDescription": "Painted Wolf Code is a desktop coding agent with a local host engine for sessions, tools, workflows, review, and confined execution. The engine, helpers, document core, browser, Git toolchain, decision engine, and resources install under /opt/painted-wolf-code; pw and pw-logs are the command-line entry points.",
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional",
        "desktopTemplate": "../../packaging/linux/painted-wolf-code.desktop.hbs",
        "preInstallScript": "../../packaging/linux/deb/preinst",
        "postInstallScript": "../../packaging/linux/deb/postinst",
        "preRemoveScript": "../../packaging/linux/deb/prerm",
        "postRemoveScript": "../../packaging/linux/deb/postrm"
      }
    }
  }
}
