<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the bundled chrome-headless-shell ONLY.
  Chromium's V8 allocates writable-executable JIT pages, which the hardened
  runtime forbids without these grants — a Developer ID build signed without
  them passes notarization and then cannot launch the browser at all.
  bundleverify asserts both keys on the signed binary. The app binary itself
  stays on the minimal entitlements.plist; do not merge these into it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
