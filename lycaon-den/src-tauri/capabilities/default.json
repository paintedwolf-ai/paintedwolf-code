{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-destroy",
    "dialog:allow-message",
    "allow-den-notify-permission-state",
    "allow-den-notify-request-permission",
    "allow-den-notify-send",
    "allow-den-notify-cancel-sessions",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        }
      ]
    },
    "allow-read-app-state",
    "allow-patch-app-state",
    "allow-document-outbox",
    "allow-app-exit",
    "allow-save-bytes",
    "allow-backup-transfer",
    "allow-reveal-in-file-manager",
    "allow-reveal-typed-path-in-file-manager",
    "allow-read-clipboard-text",
    "allow-write-clipboard-text",
    "allow-paste-into-focused-view",
    "allow-path-kind",
    "allow-import-path-kind",
    "allow-read-path-bytes",
    "allow-import-external-attachment",
    "allow-pick-path",
    "allow-open-in-editor",
    "allow-open-in-browser",
    "allow-open-local-path",
    "allow-detect-editors",
    "allow-open-third-party-notices",
    "allow-open-item-window",
    "allow-drag-item-window",
    "allow-list-item-window-views",
    "allow-workspace-view-registry",
    "allow-focus-item-window",
    "allow-close-item-window",
    "allow-shared-composer-documents",
    "allow-start-sidecar",
    "allow-export-startup-diagnostics",
    "allow-restart-sidecar",
		"allow-reset-credential-vault",
    "allow-cancel-sidecar-start",
    "allow-attach-existing-daemon",
    "allow-sidecar-info",
    "allow-reveal-managed-secret",
    "allow-den-reveal-window",
    "allow-den-set-window-bounds",
    "allow-den-set-window-backdrop",
    "allow-den-set-badge-count",
    "allow-set-app-menu",
    "allow-accessibility-preferred-text-size",
    "allow-system-appearance",
    "allow-update-service",
    "allow-shell-command-status",
    "allow-install-shell-command",
    "allow-uninstall-shell-command",
    "allow-add-shell-command-path",
    "allow-remove-shell-command-path"
  ]
}
