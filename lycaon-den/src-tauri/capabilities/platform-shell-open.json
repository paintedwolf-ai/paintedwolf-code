{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "platform-shell-open",
  "description": "Native shell URL opening on macOS and Windows",
  "platforms": [
    "macOS",
    "windows"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        }
      ]
    }
  ]
}
