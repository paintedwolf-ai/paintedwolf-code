{
  "name": "lycaon-den",
  "version": "1.0.1",
  "private": true,
  "description": "Painted Wolf Code — desktop app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint 'src/**/*.{ts,tsx}' --quiet --cache --cache-location node_modules/.cache/eslint/cache",
    "lint:full": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:web": "PLAYWRIGHT_E2E=web playwright test --project=web",
    "test:e2e:desktop": "PLAYWRIGHT_E2E=desktop playwright test --project=desktop"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@replit/codemirror-emacs": "6.1.0",
    "@replit/codemirror-vim": "6.4.0",
    "@tanstack/solid-virtual": "^3.13.31",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "diff": "^8.0.4",
    "isomorphic-dompurify": "3.22.0",
    "marked": "18.0.9",
    "overlayscrollbars": "^2.16.0",
    "semver": "^7.7.3",
    "solid-js": "^1.9.13",
    "tailwind-merge": "^3.6.0",
    "yjs": "13.6.32"
  },
  "overrides": {
    "undici": "^7.29.0",
    "js-yaml": "^4.3.1",
    "browserslist": "^4.28.7",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.3",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.8",
    "axe-core": "^4.12.1",
    "eslint": "^10.4.1",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-tailwindcss": "4.0.2",
    "jsdom": "^26.1.0",
    "lightningcss": "1.32.0",
    "msw": "^2.14.6",
    "openapi-typescript": "7.13.0",
    "@redocly/cli": "2.32.2",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "undici": "^7.29.0",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.8",
    "yaml": "^2.8.1"
  },
  "patchedDependencies": {
    "@codemirror/view@6.43.6": "patches/@codemirror+view@6.43.6-scroll-and-wrap-heights.patch",
    "overlayscrollbars@2.16.0": "patches/overlayscrollbars@2.16.0.patch"
  }
}
