{
  "id": "expr-builtins-evaluate",
  "title": "The four built-ins evaluate as specified",
  "covers": [
    "OAR-EXPR-17"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "R",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "effect": "block",
    "when": "starts_with(tool, \"re\") && ends_with(tool, \"ad\") && contains(tool, \"ea\") && size(tool) == 4 && size(tool_args) == 1 && size([\"a\", \"b\"]) == 2"
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "read",
      "tool_args": {
        "path": "/etc"
      }
    }
  },
  "expected": {
    "decision": "block",
    "code": "R",
    "applied": [
      "R:fired"
    ]
  }
}
