{
  "id": "eval-transform-does-not-short-circuit",
  "title": "A rule firing with transform lets later rules run",
  "covers": [
    "OAR-EVAL-5",
    "OAR-CONF-13"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "model.output",
      "id": "A_TRANSFORM",
      "effect": "transform",
      "transform": {
        "action": "redact",
        "target": "content"
      }
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "model.output",
      "id": "B_WARN",
      "effect": "warn"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": true
    },
    "anchor": "model.output"
  },
  "expected": {
    "decision": "transform",
    "code": "A_TRANSFORM",
    "applied": [
      "oar.test/A_TRANSFORM:fired",
      "oar.test/B_WARN:fired"
    ]
  }
}
