{
  "id": "fact-core-tier-needs-no-requires",
  "title": "Every conforming engine provides the core facts, so a rule over them needs no requires at all",
  "covers": [
    "OAR-FACT-15"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "CORE_ONLY",
      "effect": "warn",
      "when": "anchor == \"tool.pre_invoke\" && fire_count == 0 && breaker_count == 0"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 256,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "session_id": "s1"
  },
  "expected": {
    "decision": "warn",
    "code": "CORE_ONLY"
  }
}
