{
  "id": "expr-division-by-zero-raises",
  "title": "Division by zero raises, and the rule is handled per its on_error",
  "covers": [
    "OAR-EXPR-14",
    "OAR-OPS-3",
    "OAR-OPS-4"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "DIV_ZERO",
      "effect": "warn",
      "on_error": "fail_open",
      "when": "10 / 0 > 0"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "none",
    "applied": [
      "oar.test/DIV_ZERO:errored"
    ]
  }
}
