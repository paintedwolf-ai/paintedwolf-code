{
  "id": "ops-fail-closed-blocks-and-stops",
  "title": "A rule that cannot be evaluated with on_error fail_closed blocks and stops the occurrence",
  "covers": [
    "OAR-OPS-3",
    "OAR-OPS-9",
    "OAR-CONF-9",
    "OAR-CONF-25"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "detector",
      "anchor": "tool.pre_invoke",
      "id": "A_DETECTOR",
      "effect": "warn",
      "detector": {
        "ref": "detector://error"
      },
      "on_error": "fail_closed"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "detector",
      "anchor": "tool.pre_invoke",
      "id": "B_LATER",
      "effect": "nudge",
      "detector": {
        "ref": "detector://noop"
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [
        "detector://noop",
        "detector://error",
        "detector://fixture"
      ],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "block",
    "code": "A_DETECTOR",
    "rule": "oar.test/A_DETECTOR",
    "applied": [
      "oar.test/A_DETECTOR:errored"
    ]
  }
}
