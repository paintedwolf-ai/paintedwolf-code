{
  "id": "fact-host-tier-fact-loads-and-fires",
  "title": "A rule reaching a host-tier fact through requires.facts loads and fires; the capability document says so",
  "covers": [
    "OAR-FACT-18",
    "OAR-FACT-21",
    "OAR-CONF-23"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "ENTERPRISE_ONLY",
      "effect": "block",
      "requires": {
        "facts": [
          "oar.testhost.tenant_tier"
        ]
      },
      "when": "oar.testhost.tenant_tier == \"free\""
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false,
      "host_facts": [
        {
          "name": "oar.testhost.tenant_tier",
          "type": "string"
        }
      ]
    },
    "anchor": "tool.pre_invoke",
    "facts": {
      "oar.testhost.tenant_tier": "free"
    }
  },
  "expected": {
    "decision": "block",
    "code": "ENTERPRISE_ONLY"
  }
}
