{
  "id": "fact-flow-matches-a-non-contiguous-subsequence",
  "title": "flow matches when its steps appear in order in the activity window, contiguous or not",
  "covers": [
    "OAR-FACT-12"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "READ_THEN_WRITE",
      "effect": "nudge",
      "flow": [
        "read",
        "write"
      ]
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 8,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "recent_activity": [
      "read",
      "grep",
      "list",
      "write"
    ]
  },
  "expected": {
    "decision": "nudge",
    "code": "READ_THEN_WRITE"
  }
}
