{
  "id": "ops-overlapping-transforms-are-not-merged",
  "title": "Two transforms whose targets overlap apply in order rather than being merged or reordered",
  "covers": [
    "OAR-OPS-16",
    "OAR-EVAL-19"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "model.output",
      "id": "A_REPLACE",
      "effect": "transform",
      "transform": {
        "action": "replace",
        "target": "content",
        "replacement": "first"
      }
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "model.output",
      "id": "B_REPLACE",
      "effect": "transform",
      "transform": {
        "action": "replace",
        "target": "content",
        "replacement": "second"
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": true
    },
    "anchor": "model.output"
  },
  "expected": {
    "decision": "transform",
    "code": "A_REPLACE",
    "transforms": [
      {
        "action": "replace",
        "target": "content",
        "replacement": "first"
      },
      {
        "action": "replace",
        "target": "content",
        "replacement": "second"
      }
    ]
  }
}
