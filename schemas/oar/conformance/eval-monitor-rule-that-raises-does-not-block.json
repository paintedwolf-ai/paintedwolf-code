{
  "id": "eval-monitor-rule-that-raises-does-not-block",
  "title": "A monitor rule that cannot be evaluated is recorded errored and its on_error is not applied",
  "covers": [
    "OAR-EVAL-10",
    "OAR-OPS-1"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "A_UNPROVEN",
      "effect": "block",
      "enforcement": "monitor",
      "on_error": "fail_closed",
      "when": "1 / 0 == 0"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "B_LATER",
      "effect": "warn"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "warn",
    "code": "B_LATER",
    "applied": [
      "oar.test/A_UNPROVEN:monitored_errored",
      "oar.test/B_LATER:fired"
    ]
  }
}
