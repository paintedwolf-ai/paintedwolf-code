{
  "id": "eval-order-is-kind-then-qualified-id",
  "title": "Evaluation runs schema, policy, invariant, detector, then ascending by qualified identifier",
  "covers": [
    "OAR-EVAL-1",
    "OAR-CONF-10",
    "OAR-OPS-10"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "invariant",
      "anchor": "tool.pre_invoke",
      "id": "B_INVARIANT",
      "effect": "allow"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "A_POLICY",
      "effect": "allow"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "Z_SCHEMA",
      "effect": "allow"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "A_SCHEMA",
      "effect": "allow"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "none",
    "applied": [
      "oar.test/A_SCHEMA:fired",
      "oar.test/Z_SCHEMA:fired",
      "oar.test/A_POLICY:fired",
      "oar.test/B_INVARIANT:fired"
    ]
  }
}
