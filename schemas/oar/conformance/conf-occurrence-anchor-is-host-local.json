{
  "id": "conf-occurrence-anchor-is-host-local",
  "title": "input.anchor is the right-hand side of anchors.core; the core identifier on the left does not select",
  "covers": [
    "OAR-CONF-29",
    "OAR-PROF-4"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "CORE_SPELLING",
      "effect": "block"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "model.output",
      "id": "OTHER_MOMENT",
      "effect": "warn"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "gateway.before_tool",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "gateway.after_model",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "gateway.before_tool"
  },
  "expected": {
    "decision": "block",
    "code": "CORE_SPELLING",
    "applied": [
      "oar.test/CORE_SPELLING:fired"
    ]
  }
}
