{
  "id": "ops-content-anchor-evaluation-is-buffered",
  "title": "A content anchor is evaluated once, over the fully assembled content",
  "covers": [
    "OAR-OPS-8"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "model.output",
      "id": "WHOLE_CONTENT",
      "effect": "warn",
      "requires": {
        "profiles": [
          "content",
          "secrets",
          "pii",
          "prompt-injection",
          "jailbreak"
        ]
      },
      "when": "content_length == 4096",
      "on_fire": [
        "increment_counter"
      ]
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [
        "tool",
        "session",
        "filesystem",
        "content",
        "secrets",
        "pii",
        "prompt-injection",
        "jailbreak",
        "mcp"
      ],
      "activity_window": 0,
      "detectors": [
        "detector://noop",
        "detector://error",
        "detector://fixture"
      ],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "model.output",
    "facts": {
      "content_length": 4096
    },
    "session_id": "s1"
  },
  "expected": {
    "decision": "warn",
    "code": "WHOLE_CONTENT",
    "applied": [
      "oar.test/WHOLE_CONTENT:fired"
    ],
    "counters": {
      "oar.test/WHOLE_CONTENT": {
        "fire_count": 1
      }
    }
  }
}
