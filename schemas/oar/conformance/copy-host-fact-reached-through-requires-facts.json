{
  "title": "A host fact declared in requires_facts renders in copy",
  "covers": [
    "OAR-COPY-5",
    "OAR-FACT-19",
    "OAR-FACT-15"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "SPILL_NOTE",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "effect": "block",
    "when": "tool == \"read\"",
    "requires_facts": [
      "paintedwolf.spill_path"
    ],
    "what": "Retained prefix at {{ paintedwolf.spill_path }}."
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "read",
      "paintedwolf.spill_path": "tool-output/example.txt"
    },
    "host_facts": {
      "paintedwolf.spill_path": "string"
    }
  },
  "expected": {
    "decision": "block",
    "code": "SPILL_NOTE",
    "copy": {
      "what": "Retained prefix at tool-output/example.txt."
    }
  },
  "id": "copy-host-fact-reached-through-requires-facts"
}
