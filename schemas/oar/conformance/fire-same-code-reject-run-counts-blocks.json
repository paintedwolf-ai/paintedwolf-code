{
  "id": "fire-same-code-reject-run-counts-blocks",
  "title": "same_code_reject_run counts the latest blocks carrying one identifier",
  "covers": [
    "OAR-FIRE-8",
    "OAR-FIRE-10"
  ],
  "rule": [
    {
      "spec_version": "1.0",
      "id": "A_RUN_GUARD",
      "kind": "schema",
      "on": "tool.pre_invoke",
      "selector": {},
      "effect": "warn",
      "when": "same_code_reject_run >= 2"
    },
    {
      "spec_version": "1.0",
      "id": "NO_RM",
      "kind": "policy",
      "on": "tool.pre_invoke",
      "selector": {},
      "effect": "block",
      "when": "tool == \"rm\""
    }
  ],
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "ls"
    },
    "session_id": "fixture-session",
    "occurrences": [
      {
        "anchor": "tool.pre_invoke",
        "facts": {
          "tool": "rm"
        }
      },
      {
        "anchor": "tool.pre_invoke",
        "facts": {
          "tool": "rm"
        }
      }
    ]
  },
  "expected": {
    "decision": "warn",
    "code": "A_RUN_GUARD"
  }
}
