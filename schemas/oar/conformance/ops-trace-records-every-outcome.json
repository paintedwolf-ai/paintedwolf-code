{
  "id": "ops-trace-records-every-outcome",
  "title": "The trace records fired, passed, errored, monitored, and suppressed, in evaluation order",
  "covers": [
    "OAR-OPS-9",
    "OAR-OPS-10",
    "OAR-CONF-16"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "A_SUPPRESSOR",
      "effect": "warn",
      "overrides": [
        "C_SUPPRESSED"
      ]
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "B_PASSES",
      "effect": "block",
      "when": "false"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "C_SUPPRESSED",
      "effect": "block"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "D_MONITORED",
      "effect": "block",
      "enforcement": "monitor"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "invariant",
      "anchor": "tool.pre_invoke",
      "id": "E_ERRORED",
      "effect": "block",
      "on_error": "fail_open",
      "when": "1 % 0 == 0"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "warn",
    "code": "A_SUPPRESSOR",
    "applied": [
      "oar.test/A_SUPPRESSOR:fired",
      "oar.test/B_PASSES:passed",
      "oar.test/C_SUPPRESSED:suppressed",
      "oar.test/D_MONITORED:monitored_fired",
      "oar.test/E_ERRORED:errored"
    ]
  }
}
