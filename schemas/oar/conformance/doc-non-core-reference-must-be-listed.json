{
  "id": "doc-non-core-reference-must-be-listed",
  "title": "A rule referencing a standard-profile fact it does not list is rejected at load",
  "covers": [
    "OAR-DOC-22",
    "OAR-PROF-5"
  ],
  "rule": {
    "spec_version": "1.0",
