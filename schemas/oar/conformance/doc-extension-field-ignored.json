{
  "id": "doc-extension-field-ignored",
  "title": "An x- extension field is ignored rather than rejected",
  "covers": [
    "OAR-DOC-20"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "EXTENSION_OK",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "effect": "block",
    "emit": "rule:conformance",
    "when": "tool == \"read\"",
    "x-vendor-note": "ignored by other implementations"
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "read"
    }
  },
  "expected": {
    "decision": "block",
    "code": "EXTENSION_OK"
  }
}
