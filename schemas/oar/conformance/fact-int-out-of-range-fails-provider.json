{
  "title": "An int fact outside 64 bits routes the rule through on_error",
  "covers": [
    "OAR-FACT-17",
    "OAR-OPS-2"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "R",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "effect": "block",
    "when": "example.big > 0",
    "on_error": "fail_closed",
    "requires_facts": [
      "example.big"
    ]
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "example.big": 9223372036854775808
    },
    "host_facts": {
      "example.big": "int"
    }
  },
  "expected": {
    "decision": "block",
    "code": "R",
    "applied": [
      "R:errored"
    ]
  },
  "id": "fact-int-out-of-range-fails-provider"
}
