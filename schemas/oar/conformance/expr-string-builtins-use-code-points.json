{
  "id": "expr-string-builtins-use-code-points",
  "title": "String built-ins count and compare code points without folding case",
  "covers": [
    "OAR-EXPR-18"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "R",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
