{
  "id": "expr-index-typed-list-of-maps",
  "title": "list<map> indexed by int yields map, which supports in and size only",
  "covers": [
    "OAR-EXPR-13"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "model.output",
      "id": "FIRST_SPAN",
      "effect": "warn",
      "requires": {
        "profiles": [
          "content",
          "secrets",
          "pii",
          "prompt-injection",
          "jailbreak"
        ]
      },
      "when": "size(pii_entities) > 0 && \"kind\" in pii_entities[0]"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [
        "tool",
        "session",
        "filesystem",
        "content",
        "secrets",
        "pii",
        "prompt-injection",
        "jailbreak",
        "mcp"
      ],
      "activity_window": 0,
      "detectors": [
        "detector://noop",
        "detector://error",
        "detector://fixture"
      ],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "model.output",
    "facts": {
      "pii_entities": [
        {
          "kind": "email",
          "start": 3
        }
      ]
    }
  },
  "expected": {
    "decision": "warn",
    "code": "FIRST_SPAN"
  }
}
