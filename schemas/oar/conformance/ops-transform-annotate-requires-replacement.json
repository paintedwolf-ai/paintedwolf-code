{
  "id": "ops-transform-annotate-requires-replacement",
  "title": "annotate must carry a replacement: an annotation with nothing to annotate with is not a transform",
  "covers": [
    "OAR-OPS-13"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "model.output",
      "id": "NAKED_ANNOTATE",
      "effect": "transform",
      "transform": {
        "action": "annotate",
        "target": "content"
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": true
    },
    "anchor": "model.output"
  },
  "expected": {
    "error": "replacement"
  }
}
