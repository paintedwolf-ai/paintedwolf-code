{
  "id": "doc-copy-does-not-affect-the-decision",
  "title": "Two rules differing only in copy produce the same effect, and copy never reorders them",
  "covers": [
    "OAR-DOC-24",
    "OAR-EVAL-19"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "AAA",
      "effect": "warn",
      "copy": {
        "title": "zzz",
        "what": "zzz",
        "cause": "zzz",
        "why": "zzz",
        "fix": "zzz",
        "instead": "zzz"
      }
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "BBB",
      "effect": "warn"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "warn",
    "code": "AAA",
    "applied": [
      "oar.test/AAA:fired",
      "oar.test/BBB:fired"
    ]
  }
}
