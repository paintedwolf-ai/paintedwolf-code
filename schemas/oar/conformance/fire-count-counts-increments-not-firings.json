{
  "id": "fire-count-counts-increments-not-firings",
  "title": "fire_count counts applications of increment_counter, so a rule that fires with no on_fire has zero",
  "covers": [
    "OAR-FIRE-3",
    "OAR-FIRE-4",
    "OAR-EVAL-19"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "A_SILENT",
      "effect": "warn"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "B_COUNTS",
      "effect": "warn",
      "on_fire": [
        "increment_counter"
      ]
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "session_id": "s1"
  },
  "expected": {
    "decision": "warn",
    "code": "A_SILENT",
    "applied": [
      "oar.test/A_SILENT:fired",
      "oar.test/B_COUNTS:fired"
    ],
    "counters": {
      "oar.test/A_SILENT": {
        "fire_count": 0
      },
      "oar.test/B_COUNTS": {
        "fire_count": 1
      }
    }
  }
}
