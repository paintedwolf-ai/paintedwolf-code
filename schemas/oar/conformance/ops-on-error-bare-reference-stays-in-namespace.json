{
  "id": "ops-on-error-bare-reference-stays-in-namespace",
  "title": "A bare on_error reference does not resolve to the same id in another namespace",
  "covers": [
    "OAR-OPS-5"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "publisher.one",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "PRIMARY",
      "effect": "warn",
      "when": "1 / 0 == 0",
      "on_error": "FALLBACK"
    },
    {
      "oar": "1.0",
      "namespace": "publisher.two",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "FALLBACK",
      "effect": "block"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "error": "publisher.one/FALLBACK"
  }
}
