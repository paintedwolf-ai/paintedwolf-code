{
  "id": "ops-detector-transform-facts-are-rule-local",
  "title": "Each accumulated transform uses the detector facts assembled for its own rule",
  "covers": [
    "OAR-FACT-11",
    "OAR-OPS-15"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "detector",
      "anchor": "model.output",
      "id": "A_FIXTURE",
      "effect": "transform",
      "requires": {
        "profiles": [
          "content",
          "secrets",
          "pii",
          "prompt-injection",
          "jailbreak"
        ]
      },
      "detector": {
        "ref": "detector://fixture"
      },
      "transform": {
        "action": "replace",
        "target": "pii_entities",
        "replacement": "[ONE]"
      }
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "detector",
      "anchor": "model.output",
      "id": "B_NOOP",
      "effect": "transform",
      "requires": {
        "profiles": [
          "content",
          "secrets",
          "pii",
          "prompt-injection",
          "jailbreak"
        ]
      },
      "detector": {
        "ref": "detector://noop"
      },
      "transform": {
        "action": "replace",
        "target": "pii_entities",
        "replacement": "[TWO]"
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [
        "content",
        "secrets",
        "pii",
        "prompt-injection",
        "jailbreak"
      ],
      "activity_window": 0,
      "detectors": [
        "detector://fixture",
        "detector://noop"
      ],
      "expression_nodes_max": 1024,
      "supports_transform": true
    },
    "anchor": "model.output",
    "content": "abcdef",
    "detector_facts": {
      "pii_entities": [
        {
          "start": 0,
          "end": 1
        }
      ]
    }
  },
  "expected": {
    "decision": "transform",
    "code": "A_FIXTURE",
    "rule": "oar.test/A_FIXTURE",
    "content": "[ONE]bcdef",
    "transforms": [
      {
        "action": "replace",
        "target": "pii_entities",
        "replacement": "[ONE]"
      },
      {
        "action": "replace",
        "target": "pii_entities",
        "replacement": "[TWO]"
      }
    ],
    "applied": [
      "oar.test/A_FIXTURE:fired",
      "oar.test/B_NOOP:fired"
    ]
  }
}
