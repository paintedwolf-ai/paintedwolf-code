{
  "id": "expr-string-builtins-match",
  "title": "The three string built-ins match a prefix, a suffix, and a substring",
  "covers": [
    "OAR-EXPR-16"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "S",
      "effect": "block",
      "requires": {
        "profiles": [
          "filesystem",
          "tool"
        ]
      },
      "when": "starts_with(tool_arg_string(\"path\"), \"/etc/\") && ends_with(tool_arg_string(\"path\"), \".conf\") && contains(tool_arg_string(\"path\"), \"ssh\")"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [
        "tool",
        "session",
        "filesystem",
        "content",
        "secrets",
        "pii",
        "prompt-injection",
        "jailbreak",
        "mcp"
      ],
      "activity_window": 0,
      "detectors": [
        "detector://noop",
        "detector://error",
        "detector://fixture"
      ],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool_arg_string": "/etc/ssh/sshd.conf"
    }
  },
  "expected": {
    "decision": "block",
    "code": "S"
  }
}
