{
  "id": "prof-core-anchor-maps-to-a-local-name",
  "title": "A rule names the core anchor; the occurrence names the local one the host mapped it to",
  "covers": [
    "OAR-PROF-1",
    "OAR-CONF-3",
    "OAR-CONF-29"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "model.input",
      "id": "ON_MODEL_INPUT",
      "effect": "warn",
      "when": "anchor == \"model.input\""
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "content.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "content.input"
  },
  "expected": {
    "decision": "warn",
    "code": "ON_MODEL_INPUT"
  }
}
