{
  "id": "fire-actions-apply-in-declaration-and-evaluation-order",
  "title": "The actions of one rule apply in the order listed, and rules apply in evaluation order",
  "covers": [
    "OAR-FIRE-8"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "A_FIRST",
      "effect": "warn",
      "on_fire": [
        "increment_counter",
        "publish_event"
      ]
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "B_SECOND",
      "effect": "warn",
      "on_fire": [
        "increment_breaker"
      ]
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "session_id": "s1"
  },
  "expected": {
    "on_fire": [
      "increment_counter",
      "publish_event",
      "increment_breaker"
    ]
  }
}
