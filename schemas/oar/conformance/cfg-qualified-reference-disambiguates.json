{
  "id": "cfg-qualified-reference-disambiguates",
  "title": "The qualified form is required only when the bare one is actually ambiguous",
  "covers": [
    "OAR-CFG-8",
    "OAR-CFG-3"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "vendor.a",
      "id": "SHARED",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "effect": "block"
    },
    {
      "oar": "1.0",
      "namespace": "vendor.b",
      "id": "SHARED",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "effect": "warn"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "config": [
      {
        "oar_config": "1.0",
        "enforcement": {
          "vendor.a/SHARED": "off"
        }
      }
    ]
  },
  "expected": {
    "decision": "warn",
    "code": "SHARED",
    "rule": "vendor.b/SHARED",
    "applied": [
      "vendor.b/SHARED:fired"
    ]
  }
}
