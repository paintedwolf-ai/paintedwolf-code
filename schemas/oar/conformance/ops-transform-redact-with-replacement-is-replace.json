{
  "id": "ops-transform-redact-with-replacement-is-replace",
  "title": "redact carrying a replacement and replace carrying the same one produce the same rewrite",
  "covers": [
    "OAR-OPS-21"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "model.output",
      "id": "A_REDACT",
      "effect": "transform",
      "requires": {
        "profiles": [
          "content",
          "secrets",
          "pii",
          "prompt-injection",
          "jailbreak"
        ]
      },
      "when": "size(secret_matches) > 0",
      "transform": {
        "action": "redact",
        "target": "secret_matches",
        "replacement": "[m]"
      }
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "model.output",
      "id": "B_REPLACE",
      "effect": "transform",
      "requires": {
        "profiles": [
          "content",
          "secrets",
          "pii",
          "prompt-injection",
          "jailbreak"
        ]
      },
      "when": "size(pii_entities) > 0",
      "transform": {
        "action": "replace",
        "target": "pii_entities",
        "replacement": "[m]"
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [
        "tool",
        "session",
        "filesystem",
        "content",
        "secrets",
        "pii",
        "prompt-injection",
        "jailbreak",
        "mcp"
      ],
      "activity_window": 0,
      "detectors": [
        "detector://noop",
        "detector://error",
        "detector://fixture"
      ],
      "expression_nodes_max": 1024,
      "supports_transform": true
    },
    "anchor": "model.output",
    "content": "call 555-0100 or 555-0199 now",
    "facts": {
      "secret_matches": [
        {
          "start": 5,
          "end": 13
        }
      ],
      "pii_entities": [
        {
          "start": 17,
          "end": 25
        }
      ]
    }
  },
  "expected": {
    "decision": "transform",
    "code": "A_REDACT",
    "content": "call [m] or [m] now"
  }
}
