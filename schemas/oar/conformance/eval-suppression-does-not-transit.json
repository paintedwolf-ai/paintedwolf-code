{
  "id": "eval-suppression-does-not-transit",
  "title": "If A overrides B and B overrides C, A firing suppresses B but not C",
  "covers": [
    "OAR-EVAL-15"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "A_TOP",
      "effect": "warn",
      "overrides": [
        "B_MIDDLE"
      ]
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "B_MIDDLE",
      "effect": "nudge",
      "overrides": [
        "C_BOTTOM"
      ]
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "invariant",
      "anchor": "tool.pre_invoke",
      "id": "C_BOTTOM",
      "effect": "block"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "block",
    "code": "C_BOTTOM",
    "applied": [
      "oar.test/A_TOP:fired",
      "oar.test/B_MIDDLE:suppressed",
      "oar.test/C_BOTTOM:fired"
    ]
  }
}
