{
  "id": "eval-monitor-does-not-short-circuit-or-suppress",
  "title": "A monitored rule neither short-circuits the occurrence nor suppresses the rule it overrides",
  "covers": [
    "OAR-EVAL-10",
    "OAR-CONF-11"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "GENERAL",
      "effect": "warn"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "SPECIFIC",
      "effect": "block",
      "enforcement": "monitor",
      "overrides": [
        "GENERAL"
      ]
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "warn",
    "code": "GENERAL",
    "applied": [
      "oar.test/SPECIFIC:monitored_fired",
      "oar.test/GENERAL:fired"
    ]
  }
}
