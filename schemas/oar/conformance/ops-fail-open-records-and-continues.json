{
  "id": "ops-fail-open-records-and-continues",
  "title": "A rule that cannot be evaluated with on_error fail_open contributes nothing and evaluation continues",
  "covers": [
    "OAR-OPS-4"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "detector",
      "anchor": "tool.pre_invoke",
      "id": "A_DETECTOR",
      "effect": "block",
      "detector": {
        "ref": "detector://error"
      },
      "on_error": "fail_open",
      "on_fire": [
        "increment_counter"
      ]
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "detector",
      "anchor": "tool.pre_invoke",
      "id": "B_LATER",
      "effect": "warn",
      "detector": {
        "ref": "detector://noop"
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [
        "detector://noop",
        "detector://error",
        "detector://fixture"
      ],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "session_id": "s1"
  },
  "expected": {
    "decision": "warn",
    "code": "B_LATER",
    "applied": [
      "oar.test/A_DETECTOR:errored",
      "oar.test/B_LATER:fired"
    ],
    "on_fire": [],
    "counters": {
      "oar.test/A_DETECTOR": {
        "fire_count": 0
      }
    }
  }
}
