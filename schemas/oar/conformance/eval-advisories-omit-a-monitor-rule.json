{
  "id": "eval-advisories-omit-a-monitor-rule",
  "title": "A monitor nudge is recorded and does not appear on advisories",
  "covers": [
    "OAR-EVAL-20",
    "OAR-EVAL-10"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "A_ENFORCE",
      "effect": "nudge",
      "copy": {
        "what": "Cite a recorded observation."
      }
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "B_WATCH",
      "effect": "nudge",
      "enforcement": "monitor",
      "copy": {
        "what": "This steer is being watched, not applied."
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "nudge",
    "code": "A_ENFORCE",
    "advisories": [
      {
        "code": "A_ENFORCE",
        "rule": "oar.test/A_ENFORCE"
      }
    ],
    "applied": [
      "oar.test/A_ENFORCE:fired",
      "oar.test/B_WATCH:monitored_fired"
    ]
  }
}
