{
  "id": "ops-monitor-suppresses-effect",
  "title": "A rule in monitor mode is recorded but produces no effect",
  "covers": [
    "OAR-OPS-1",
    "OAR-CONF-9"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "MONITORED",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "effect": "block",
    "when": "tool == \"read\"",
    "enforcement": "monitor"
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "read"
    }
  },
  "expected": {
    "decision": "none",
    "applied": [
      "MONITORED:monitor"
    ]
  }
}
