{
  "id": "prof-history-records-admitted-tool-names",
  "title": "prof history records admitted tool names",
  "covers": [
    "OAR-PROF-9",
    "OAR-CONF-40"
  ],
  "rules": [
    {
      "oar": "1.0",
      "id": "TEST",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "effect": "warn",
      "flow": [
        "read",
        "write"
      ]
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 3,
      "detectors": [],
      "expression_nodes_max": 256,
      "supports_transform": false
    },
    "occurrences": [
      {
        "anchor": "tool.pre_invoke",
        "tool_call": {
          "name": "read",
          "arguments": {}
        },
        "expected": {
          "decision": "none"
        }
      },
      {
        "anchor": "tool.pre_invoke",
        "tool_call": {
          "name": "write",
          "arguments": {}
        },
        "expected": {
          "decision": "none"
        }
      },
      {
        "anchor": "tool.pre_invoke",
        "tool_call": {
          "name": "read",
          "arguments": {}
        }
      }
    ]
  },
  "expected": {
    "decision": "warn"
  }
}
