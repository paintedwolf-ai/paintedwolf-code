{
  "id": "eval-advisories-omit-a-suppressed-rule",
  "title": "A suppressed nudge does not appear on advisories",
  "covers": [
    "OAR-EVAL-20",
    "OAR-EVAL-14"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "A_SPECIFIC",
      "effect": "nudge",
      "overrides": [
        "B_GENERAL"
      ],
      "copy": {
        "what": "Read inside the declared scope."
      }
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "B_GENERAL",
      "effect": "nudge",
      "copy": {
        "what": "Stay inside scope."
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "nudge",
    "code": "A_SPECIFIC",
    "advisories": [
      {
        "code": "A_SPECIFIC",
        "rule": "oar.test/A_SPECIFIC"
      }
    ],
    "applied": [
      "oar.test/A_SPECIFIC:fired",
      "oar.test/B_GENERAL:suppressed"
    ]
  }
}
