{
  "id": "cfg-mandatory-rule-cannot-be-disabled",
  "title": "A configuration disabling a mandatory rule is rejected, naming the rule",
  "covers": [
    "OAR-CFG-5",
    "OAR-OPS-7"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "IMMOVABLE",
      "effect": "block",
      "mandatory": true
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "config": [
      {
        "oar_config": "1.0",
        "disable": [
          "IMMOVABLE"
        ]
      }
    ]
  },
  "expected": {
    "error": "oar.test/IMMOVABLE"
  }
}
