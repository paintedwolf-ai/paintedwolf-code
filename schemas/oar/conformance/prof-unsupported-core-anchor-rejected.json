{
  "id": "prof-unsupported-core-anchor-rejected",
  "title": "A rule targeting a core anchor the host declares unsupported is refused, naming the anchor",
  "covers": [
    "OAR-PROF-4",
    "OAR-DOC-12",
    "OAR-CONF-3",
    "OAR-CONF-20"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "agent.finalize",
      "id": "NEEDS_FINALIZE",
      "effect": "warn"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": [
          "agent.finalize"
        ]
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "error": "agent.finalize"
  }
}
