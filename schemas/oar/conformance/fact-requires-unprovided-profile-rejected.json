{
  "id": "fact-requires-unprovided-profile-rejected",
  "title": "A rule naming a profile the host does not provide is refused at load, naming both",
  "covers": [
    "OAR-FACT-19",
    "OAR-CONF-4",
    "OAR-CONF-20"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "NEEDS_MCP",
      "effect": "block",
      "requires": {
        "profiles": [
          "mcp"
        ]
      },
      "when": "mcp_call_ok"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "error": "mcp"
  }
}
