{
  "id": "ops-transform-redact-may-omit-replacement",
  "title": "redact may omit its replacement, and the engine substitutes its own placeholder",
  "covers": [
    "OAR-OPS-13"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "model.output",
      "id": "BARE_REDACT",
      "effect": "transform",
      "transform": {
        "action": "redact",
        "target": "content"
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": true
    },
    "anchor": "model.output"
  },
  "expected": {
    "decision": "transform",
    "code": "BARE_REDACT",
    "transforms": [
      {
        "action": "redact",
        "target": "content"
      }
    ]
  }
}
