{
  "id": "doc-mandatory-and-overrides-default",
  "title": "mandatory defaults to false and overrides to the empty list, so an ordinary rule is suppressible",
  "covers": [
    "OAR-DOC-17",
    "OAR-DOC-20"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "GENERAL",
      "effect": "block"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "SPECIFIC",
      "effect": "warn",
      "overrides": [
        "GENERAL"
      ]
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "warn",
    "code": "SPECIFIC",
    "applied": [
      "oar.test/SPECIFIC:fired",
      "oar.test/GENERAL:suppressed"
    ]
  }
}
