{
  "title": "A fact at its zero value renders, it does not vanish",
  "covers": [
    "OAR-FACT-25",
    "OAR-COPY-4",
    "OAR-FACT-24"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "ZEROES",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "effect": "block",
    "when": "tool == \"\"",
    "what": "n={{ example.attempts }} labels={{ example.labels }} name={{ example.name }}.",
    "requires_facts": [
      "example.attempts",
      "example.labels",
      "example.name"
    ]
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": ""
    },
    "host_facts": {
      "example.attempts": "int",
      "example.labels": "list<string>",
      "example.name": "string"
    }
  },
  "expected": {
    "decision": "block",
    "code": "ZEROES",
    "copy": {
      "what": "n=0 labels= name=."
    }
  },
  "id": "copy-zero-value-renders"
}
