{
  "id": "fire-every-condition-sees-the-same-counter-snapshot",
  "title": "A rule's own increment cannot change the value its own condition just read",
  "covers": [
    "OAR-FIRE-6"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "A_BUMPS",
      "effect": "warn",
      "on_fire": [
        "increment_counter"
      ],
      "when": "fire_count == 0"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "B_READS",
      "effect": "nudge",
      "when": "fire_count == 0"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "session_id": "s1"
  },
  "expected": {
    "decision": "nudge",
    "code": "B_READS",
    "applied": [
      "oar.test/A_BUMPS:fired",
      "oar.test/B_READS:fired"
    ],
    "counters": {
      "oar.test/A_BUMPS": {
        "fire_count": 1
      }
    }
  }
}
