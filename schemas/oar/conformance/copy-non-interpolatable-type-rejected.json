{
  "title": "Copy binding a map fact is rejected at load",
  "covers": [
    "OAR-COPY-4"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "R",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "effect": "block",
    "when": "tool == \"read\"",
    "what": "args {{ tool_args }}."
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "read"
    }
  },
  "expected": {
    "error": "tool_args"
  },
  "id": "copy-non-interpolatable-type-rejected"
}
