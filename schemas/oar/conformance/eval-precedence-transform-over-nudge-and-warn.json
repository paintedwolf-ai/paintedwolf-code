{
  "id": "eval-precedence-transform-over-nudge-and-warn",
  "title": "transform outranks nudge, and nudge outranks warn",
  "covers": [
    "OAR-EVAL-6",
    "OAR-EVAL-20",
    "OAR-CONF-14"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "model.output",
      "id": "A_WARN",
      "effect": "warn"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "model.output",
      "id": "B_NUDGE",
      "effect": "nudge"
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "model.output",
      "id": "C_TRANSFORM",
      "effect": "transform",
      "transform": {
        "action": "annotate",
        "target": "content",
        "replacement": "reviewed"
      }
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": true
    },
    "anchor": "model.output"
  },
  "expected": {
    "decision": "transform",
    "code": "C_TRANSFORM",
    "advisories": [],
    "applied": [
      "oar.test/A_WARN:fired",
      "oar.test/B_NUDGE:fired",
      "oar.test/C_TRANSFORM:fired"
    ]
  }
}
