{
  "id": "doc-legacy-tools-filter-honoured",
  "title": "The deprecated top-level tools list still scopes a rule when selector.tools is absent",
  "covers": [
    "OAR-DOC-19"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "LEGACY_TOOL_FILTER",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "effect": "block",
    "emit": "rule:conformance",
    "when": "true",
    "tools": [
      "read"
    ]
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "read"
    }
  },
  "expected": {
    "decision": "block",
    "code": "LEGACY_TOOL_FILTER"
  }
}
