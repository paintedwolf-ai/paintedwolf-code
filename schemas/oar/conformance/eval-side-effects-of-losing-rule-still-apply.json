{
  "id": "eval-side-effects-of-losing-rule-still-apply",
  "title": "on_fire applies to every rule that fired and was enforced, including one whose effect lost precedence",
  "covers": [
    "OAR-EVAL-12",
    "OAR-CONF-15"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "schema",
      "anchor": "tool.pre_invoke",
      "id": "A_WARN",
      "effect": "warn",
      "on_fire": [
        "increment_counter"
      ]
    },
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "B_NUDGE",
      "effect": "nudge",
      "on_fire": [
        "increment_breaker"
      ]
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "session_id": "s1"
  },
  "expected": {
    "decision": "nudge",
    "code": "B_NUDGE",
    "on_fire": [
      "increment_counter",
      "increment_breaker"
    ],
    "counters": {
      "oar.test/A_WARN": {
        "fire_count": 1
      },
      "oar.test/B_NUDGE": {
        "breaker_count": 1
      }
    }
  }
}
