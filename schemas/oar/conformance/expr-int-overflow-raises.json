{
  "id": "expr-int-overflow-raises",
  "title": "Integer arithmetic that overflows 64 bits raises rather than wrapping",
  "covers": [
    "OAR-EXPR-15",
    "OAR-FACT-23"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "OVERFLOW",
      "effect": "warn",
      "on_error": "fail_open",
      "when": "9223372036854775807 + 1 > 0"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "decision": "none",
    "applied": [
      "oar.test/OVERFLOW:errored"
    ]
  }
}
