{
  "id": "eval-block-short-circuits",
  "title": "The first rule that fires with block stops the anchor occurrence",
  "covers": [
    "OAR-EVAL-3",
    "OAR-CONF-10"
  ],
  "rule": [
    {
      "spec_version": "1.0",
      "id": "A_BLOCKS",
      "kind": "schema",
      "on": "tool.pre_invoke",
      "selector": {},
      "effect": "block",
      "when": "tool == \"read\""
    },
    {
      "spec_version": "1.0",
      "id": "B_NEVER_REACHED",
      "kind": "policy",
      "on": "tool.pre_invoke",
      "selector": {},
      "effect": "warn",
      "when": "tool == \"read\""
    }
  ],
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "read"
    }
  },
  "expected": {
    "decision": "block",
    "code": "A_BLOCKS",
    "applied": [
      "A_BLOCKS:fired"
    ]
  }
}
