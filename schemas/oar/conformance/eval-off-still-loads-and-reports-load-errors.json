{
  "id": "eval-off-still-loads-and-reports-load-errors",
  "title": "A rule whose enforcement is off remains loaded, so a load-time error in it is still reported",
  "covers": [
    "OAR-EVAL-11",
    "OAR-OPS-2"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "oar.test",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "id": "DISABLED_BUT_BROKEN",
      "effect": "block",
      "enforcement": "off",
      "when": "ghost_fact"
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke"
  },
  "expected": {
    "error": "ghost_fact"
  }
}
