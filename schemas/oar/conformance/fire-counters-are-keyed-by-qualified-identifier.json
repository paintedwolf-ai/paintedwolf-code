{
  "id": "fire-counters-are-keyed-by-qualified-identifier",
  "title": "Two rules sharing a bare id under different namespaces keep separate counters",
  "covers": [
    "OAR-FIRE-5"
  ],
  "rules": [
    {
      "oar": "1.0",
      "namespace": "acme.a",
      "id": "COUNTED",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "effect": "warn",
      "on_fire": [
        "increment_counter"
      ]
    },
    {
      "oar": "1.0",
      "namespace": "acme.b",
      "id": "COUNTED",
      "kind": "policy",
      "anchor": "tool.pre_invoke",
      "effect": "warn",
      "on_fire": [
        "increment_counter",
        "increment_counter"
      ]
    }
  ],
  "input": {
    "capability": {
      "oar_capability_version": "1.0",
      "host": "oar.testhost",
      "anchors": {
        "core": {
          "tool.pre_invoke": "tool.pre_invoke",
          "tool.handler": "tool.handler",
          "tool.post_invoke": "tool.post_invoke",
          "agent.post_turn": "agent.post_turn",
          "agent.finalize": "agent.finalize",
          "model.input": "model.input",
          "model.output": "model.output",
          "model.tool_result": "model.tool_result"
        },
        "unsupported": []
      },
      "profiles": [],
      "activity_window": 0,
      "detectors": [],
      "expression_nodes_max": 1024,
      "supports_transform": false
    },
    "anchor": "tool.pre_invoke",
    "session_id": "s1"
  },
  "expected": {
    "counters": {
      "acme.a/COUNTED": {
        "fire_count": 1
      },
      "acme.b/COUNTED": {
        "fire_count": 2
      }
    }
  }
}
