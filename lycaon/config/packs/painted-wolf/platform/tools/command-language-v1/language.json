{
  "version": 1,
  "parser": {
    "module": "mvdan.cc/sh/v3",
    "version": "v3.14.1",
    "dialect": "bash",
    "allowed_packages": [
      "syntax",
      "expand",
      "pattern"
    ],
    "forbidden_packages": [
      "interp"
    ],
    "effect_boundary": "host dispatch only"
  },
  "encoding": {
    "program": "UTF-8; reject invalid UTF-8 and NUL before effects",
    "streams": "bytes; preserve NUL and CRLF",
    "document": "captured accepted text encoded with recorded newline/encoding policy",
    "ordering": "unsigned byte lexical order; no ambient locale"
  },
  "syntax": {
    "supported": [
      "simple commands",
      "single quotes",
      "double quotes",
      "escapes",
      "pipes",
      ";",
      "&&",
      "||",
      "grouped statements",
      "multiline programs",
      "stdin",
      "here-documents",
      ">",
      ">>",
      "2>",
      "2>>",
      "&>",
      "&>>",
      "<",
      "2>&1",
      "1>&2",
      "assignments",
      "export",
      "unset",
      "env",
      "printenv",
      "variables",
      "globs",
      "$()",
      "backticks",
      "if",
      "for",
      "while",
      "functions",
      "return",
      "exit",
      "break",
      "continue",
      "test",
      "[",
      "[[",
      "source --",
      "trailing &",
      "$!",
      "jobs",
      "wait",
      "kill"
    ],
    "excluded": [
      "eval",
      "executable reparsing",
      "process substitution",
      "traps",
      "arrays",
      "shell options",
      "persistent interpreter state",
      "dynamic loading via environment",
      "tilde-user lookup"
    ]
  },
  "rules": {
    "splitting": "Unquoted expansions split on space/tab/LF then glob; quoted expansions retain one argument; fixed IFS cannot be changed.",
    "globs": "Sort byte order; exclude hidden names unless requested; unmatched patterns stay literal; never traverse symlinks.",
    "substitution": "Reached units only; strip trailing LF bytes; refuse NUL scalar; failure prevents containing dispatch; never reparse output.",
    "admission": "Validate complete submitted unit before effects; bind computed arguments when reached. Source captures and validates its own unit, retaining earlier parent effects.",
    "dispatch": "Native names bind first, including unsupported flags. Bare other programs dispatch confined. external -- explicitly selects installed binaries. No shell fallback.",
    "paths": "Relative cwd, @label, @scratch and native absolute operands preserve physical identity; native_path converts explicitly and grants no access. TMPDIR and mktemp use real session paths. Null redirects use typed device sinks.",
    "statuses": "Last executed ordinary status; pipelines use rightmost nonzero after expected early closure. Grep/diff comparison 1 remains complete. Host terminal reasons latch and prevent later admission.",
    "publication": "Every producer must be typed eligible and complete; native grep/diff comparison 1 qualifies, unclassified external nonzero does not. Capture revisions before producer, stage bytes, review, validate and publish per target. Never pre-truncate or replay producer.",
    "evidence": "Execution pins differ from conversational delivery. Only delivered exact mapped cat/head/tail/nl ranges qualify an edit base; unseen output and arbitrary transforms do not.",
    "jobs": "Session job handles, not global PIDs; capture cwd/environment, bounded lifetime/output, owned cancellation; no interpreter checkpoints.",
    "secrets": "References remain opaque except declared authorized sinks; inserted bytes never become grammar.",
    "progress_update": "Optional existing update_progress payload; validate envelope/program before either effect; progress owner settles independently before gated effects. Zero-program-effect fresh resubmission references never imply zero progress effects."
  },
