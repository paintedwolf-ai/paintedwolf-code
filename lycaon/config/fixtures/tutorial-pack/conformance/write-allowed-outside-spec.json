{
  "id": "write-allowed-outside-spec",
  "title": "Triage Lite allows a write outside spec posture",
  "covers": [
    "OAR-SEL-2",
    "OAR-EVAL-4"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "TRIAGE_LITE_WRITE_FORBIDDEN",
    "title": "Triage Lite is read-only",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "requires_facts": [
      "paintedwolf.operation",
      "paintedwolf.session_posture"
    ],
    "when": "paintedwolf.operation in [\"write\", \"edit\"] && paintedwolf.session_posture == \"spec\"",
    "effect": "block",
    "enforcement": "enforce",
    "on_error": "fail_closed",
    "x-paintedwolf-emit": "rule:triage_lite",
    "message": "Triage Lite is a read-only workflow.",
    "what": "A write tool was called during triage.",
    "cause": "The triage-lite workflow reports findings; it does not change files.",
    "why": "Triage runs in the spec posture, where the project tree stays untouched.",
    "fix": "Record the finding in your write-up, then leave triage before editing.",
    "instead": "Branch on Code TRIAGE_LITE_WRITE_FORBIDDEN and report instead of writing",
    "x-paintedwolf-scenarios": [
      {
        "id": "default",
        "vars": {
          "tool": "write",
          "path": "src/main.go",
          "session_role": "coordinator"
        },
        "expect_contains": [
          "Rejected:",
          "Code: TRIAGE_LITE_WRITE_FORBIDDEN",
          "leave triage"
        ]
      }
    ]
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "write",
      "paintedwolf.operation": "write",
      "paintedwolf.session_posture": "build"
    },
    "host_facts": {
      "paintedwolf.operation": "string",
      "paintedwolf.session_posture": "string"
    }
  },
  "expected": {
    "decision": "none",
    "applied": [
      "TRIAGE_LITE_WRITE_FORBIDDEN:passed"
    ]
  }
}
