{
  "id": "mcp-server-disabled-blocked",
  "title": "A call to a configured but disabled bridged server is blocked",
  "covers": [
    "OAR-DOC-22",
    "OAR-FACT-13"
  ],
  "rule": {
    "spec_version": "1.0",
    "id": "MCP_SERVER_DISABLED",
    "namespace": "example.security",
    "kind": "policy",
    "on": "tool.pre_invoke",
    "selector": {},
    "requires_facts": [
      "mcp_server_id",
      "mcp_server_enabled"
    ],
    "when": "mcp_server_id != \"\" && !mcp_server_enabled",
    "effect": "block",
    "profile": "portable",
    "what": "The call targets a bridged server that is configured but not enabled.",
    "fix": "Enable the server in the catalogue, or route the call elsewhere."
  },
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "mcp_server_id": "github",
      "mcp_server_enabled": false
    }
  },
  "expected": {
    "decision": "block",
    "code": "MCP_SERVER_DISABLED",
    "applied": [
      "example.security/MCP_SERVER_DISABLED:fired"
    ]
  }
}
