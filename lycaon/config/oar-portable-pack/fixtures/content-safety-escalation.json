{
  "id": "content-safety-escalation",
  "title": "A high jailbreak score blocks after the injection flag fires",
  "covers": [
    "OAR-OPS-9",
    "OAR-EVAL-1",
    "OAR-EVAL-3",
    "OAR-EVAL-4"
  ],
  "rule": [
    {
      "spec_version": "1.0",
      "namespace": "example.security",
      "emit": "example:pack",
      "id": "INJECTION_FLAGGED",
      "kind": "detector",
      "on": "model.output",
      "selector": {},
      "requires_facts": [
        "prompt_injection_score"
      ],
      "detector": {
        "ref": "detector://fixture"
      },
      "when": "prompt_injection_score > 0.5",
      "effect": "warn",
      "profile": "portable"
    },
    {
      "spec_version": "1.0",
      "namespace": "example.security",
      "emit": "example:pack",
      "id": "JAILBREAK_REFUSED",
      "kind": "detector",
      "on": "model.output",
      "selector": {},
      "requires_facts": [
        "jailbreak_score"
      ],
      "detector": {
        "ref": "detector://fixture"
      },
      "when": "jailbreak_score > 0.8",
      "effect": "block",
      "profile": "portable"
    }
  ],
  "input": {
    "anchor": "model.output",
    "facts": {
      "prompt_injection_score": 0.91,
      "jailbreak_score": 0.93
    }
  },
  "expected": {
    "decision": "block",
    "code": "JAILBREAK_REFUSED",
    "applied": [
      "INJECTION_FLAGGED:fired",
      "JAILBREAK_REFUSED:fired"
    ]
  }
}
