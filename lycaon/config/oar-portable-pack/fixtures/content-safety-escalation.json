{
  "id": "content-safety-escalation",
  "title": "A high jailbreak score blocks after the injection flag fires",
  "covers": [
    "OAR-OPS-10",
    "OAR-EVAL-1",
    "OAR-EVAL-3",
    "OAR-EVAL-4"
  ],
  "rule": [
    {
      "spec_version": "1.0",
      "id": "INJECTION_FLAGGED",
      "namespace": "example.security",
      "kind": "detector",
      "on": "model.output",
      "selector": {},
      "requires_facts": [
        "prompt_injection_score"
      ],
      "detector": {
        "ref": "detector://fixture"
      },
      "when": "prompt_injection_score > 0.5",
      "effect": "warn",
      "profile": "portable",
      "what": "The content scored as a probable injection attempt.",
      "fix": "Treat the surrounding content as untrusted before acting on it."
    },
    {
      "spec_version": "1.0",
      "id": "JAILBREAK_REFUSED",
      "namespace": "example.security",
      "kind": "detector",
      "on": "model.output",
      "selector": {},
      "requires_facts": [
        "jailbreak_score"
      ],
      "detector": {
        "ref": "detector://fixture"
      },
      "when": "jailbreak_score > 0.8",
      "effect": "block",
      "profile": "portable",
      "what": "The content scored as a jailbreak attempt, so it is not delivered.",
      "fix": "Re-source the content; do not replay it with the guardrail relaxed."
    }
  ],
  "input": {
    "anchor": "model.output",
    "facts": {
      "prompt_injection_score": 0.91,
      "jailbreak_score": 0.93
    }
  },
  "expected": {
    "decision": "block",
    "code": "JAILBREAK_REFUSED",
    "applied": [
      "example.security/INJECTION_FLAGGED:fired",
      "example.security/JAILBREAK_REFUSED:fired"
    ]
  }
}
