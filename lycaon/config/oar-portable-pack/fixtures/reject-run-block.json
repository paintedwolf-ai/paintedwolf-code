{
  "id": "reject-run-block",
  "title": "Three consecutive same-code rejections refuse the call",
  "covers": [
    "OAR-FIRE-3",
    "OAR-EVAL-1",
    "OAR-EVAL-3"
  ],
  "rule": [
    {
      "spec_version": "1.0",
      "namespace": "example.hygiene",
      "emit": "example:pack",
      "id": "REJECT_RUN_BLOCK",
      "kind": "invariant",
      "on": "tool.pre_invoke",
      "selector": {},
      "when": "same_code_reject_run >= 3",
      "effect": "block",
      "on_fire": [
        "publish_event"
      ],
      "profile": "portable"
    },
    {
      "spec_version": "1.0",
      "namespace": "example.hygiene",
      "emit": "example:pack",
      "id": "REJECT_RUN_WARN",
      "kind": "invariant",
      "on": "tool.pre_invoke",
      "selector": {},
      "when": "same_code_reject_run >= 2",
      "effect": "warn",
      "profile": "portable"
    }
  ],
  "input": {
    "anchor": "tool.pre_invoke",
    "facts": {
      "tool": "read",
      "same_code_reject_run": 3
    },
    "session_id": "pack-session"
  },
  "expected": {
    "decision": "block",
    "code": "REJECT_RUN_BLOCK",
    "applied": [
      "REJECT_RUN_BLOCK:fired"
    ]
  }
}
