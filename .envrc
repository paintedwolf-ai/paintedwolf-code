# Dev environment: pinned task and this checkout's builds on PATH. Run once: ./task setup-dev  (or direnv allow)
TASK_VERSION="v3.51.1"
PW_BIN_DIR="$(python3 scripts/artifact_paths.py bin "${PWD}")"
PW_BUILD_DIR="$(python3 scripts/artifact_paths.py build "${PWD}")"
TASK_BIN="${PW_BIN_DIR}/task"

if [[ ! -x "${TASK_BIN}" ]]; then
  mkdir -p "${PW_BIN_DIR}"
  GOBIN="${PW_BIN_DIR}" go install "github.com/go-task/task/v3/cmd/task@${TASK_VERSION}"
fi

PATH_add "${PW_BIN_DIR}"
PATH_add "${PW_BUILD_DIR}"

# Match lycaon/go.mod — avoids default-toolchain vs module-version drift (golangci-lint, tests).
export GOTOOLCHAIN="go$(grep '^go ' lycaon/go.mod | awk '{print $2}')"
