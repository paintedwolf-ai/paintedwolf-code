# Lets Go test binaries under the verification scratch root, and the Den loader
# boundary test, create user namespaces on hosts that restrict them to profiled
# programs, so those tests exercise the boundary instead of failing on host policy.
abi <abi/4.0>,

include <tunables/global>

profile paintedwolf-go-test /tmp/paintedwolf-test-runs-*/**/*.test flags=(unconfined) {
  userns,
}

profile paintedwolf-den-module-audit-test /**/deps/linux_module_audit-* flags=(unconfined) {
  userns,
}
