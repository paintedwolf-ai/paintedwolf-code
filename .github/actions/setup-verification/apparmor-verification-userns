# Verification engines need user namespaces to construct their command sandboxes.
abi <abi/4.0>,

include <tunables/global>

profile paintedwolf-go-test /tmp/paintedwolf-test-runs-*/**/*.test flags=(unconfined) {
  userns,
}

profile paintedwolf-smoke /tmp/paintedwolf-test-runs-*/**/lycaon-smoke-bin-*/lycaon flags=(unconfined) {
  userns,
}

profile paintedwolf-e2e-container /tmp/lycaon flags=(unconfined) {
  userns,
}

profile paintedwolf-den-module-audit-test /**/deps/linux_module_audit-* flags=(unconfined) {
  userns,
}
