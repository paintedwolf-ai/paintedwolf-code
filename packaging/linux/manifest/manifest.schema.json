{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paintedwolf.ai/schemas/linux-package-manifest.json",
  "title": "Painted Wolf Code Linux package manifest",
  "description": "Complete app-managed native payload inventory and executable identities for native and immutable Nix applications. Installation identity and privileged trust are established separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "package",
    "version",
    "architecture",
    "install_root",
    "executables",
    "payload"
  ],
  "properties": {
    "format_version": {
      "const": 2
    },
    "package": {
      "const": "painted-wolf-code"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "install_root": {
      "anyOf": [
        {
          "const": "/opt/painted-wolf-code"
        },
        {
          "type": "string",
          "pattern": "^/nix/store/[0-9abcdfghijklmnpqrsvwxyz]{32}-[A-Za-z0-9+._?=-]+/lib/painted-wolf-code$"
        }
      ]
    },
    "executables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "payload": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "mode",
          "sha256",
          "size",
          "target"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "file",
              "directory",
              "symlink"
            ]
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
