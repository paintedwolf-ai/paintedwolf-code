#!/bin/sh
set -e
# Register the package-authored units and refresh desktop caches; nothing else.
SOCKET_UNIT=paintedwolf-vault-identity.socket
SERVICE_UNIT=paintedwolf-vault-identity.service
if [ -f "/usr/lib/systemd/system/${SOCKET_UNIT}" ] && [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  if [ "$1" = "configure" ]; then
    if [ -z "${2:-}" ]; then
      systemctl enable --now "${SOCKET_UNIT}" || true
    else
      # Restart an active instance without changing the administrator's enablement.
      systemctl try-restart "${SERVICE_UNIT}" || true
    fi
  fi
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f /usr/share/icons/hicolor/index.theme ]; then
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi
if [ "$1" = "configure" ] && command -v apparmor_parser >/dev/null 2>&1 && [ -f /etc/apparmor.d/painted-wolf-code ] && [ -d /sys/kernel/security/apparmor ]; then
  apparmor_parser -r -T -W /etc/apparmor.d/painted-wolf-code || true
fi
exit 0
