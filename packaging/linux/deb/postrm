#!/bin/sh
set -e
# Refresh caches after the package files are gone; user data is never touched.
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f /usr/share/icons/hicolor/index.theme ]; then
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi
if [ "$1" = "purge" ]; then
  # A generation a launch still held at removal stays until nothing holds its
  # lifetime lock; the policy that selected it is gone.
  rm -f /etc/paintedwolf/launch.json
  rmdir /etc/paintedwolf 2>/dev/null || true
  for generation in /opt/painted-wolf-code/generations/* /opt/painted-wolf-code/generations/.install-*; do
    [ -d "$generation" ] || continue
    identity=${generation##*/}
    identity=${identity#.install-}
    lock="/run/paintedwolf/generation-locks/${identity}.lock"
    # Lifetime locks are root 0600; never let flock create one with another mode.
    mkdir -p /run/paintedwolf/generation-locks
    (umask 077 && : >> "$lock")
    flock -n -x "$lock" rm -rf -- "$generation" || true
  done
fi
case "$1" in
  remove|purge)
    if [ -d /opt/painted-wolf-code ]; then
      find /opt/painted-wolf-code -depth -type d -empty -delete 2>/dev/null || true
    fi
    ;;
esac
exit 0
