#!/bin/sh
set -e
# Stop the identity socket on removal; upgrades keep it running for the new unit.
SOCKET_UNIT=painted-wolf-code-identity.socket
case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ] && [ -f "/usr/lib/systemd/system/${SOCKET_UNIT}" ]; then
      systemctl disable --now "${SOCKET_UNIT}" || true
      systemctl stop painted-wolf-code-identity.service || true
    fi
    ;;
esac
exit 0
