_pw_refresh_desktop() {
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
    fi
}

post_install() {
    _pw_refresh_desktop
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable --now paintedwolf-vault-identity.socket
    elif [ -d /run/openrc ] && command -v rc-service >/dev/null 2>&1; then
        rc-update add paintedwolf-vault-identity default
        rc-service paintedwolf-vault-identity start
    else
        printf '%s\n' 'New or reopened app sessions require the packaged vault identity service to establish credential custody. Enable it with your configured systemd or OpenRC service manager; saved credentials remain intact.'
    fi
}

post_upgrade() {
    _pw_refresh_desktop
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl try-restart paintedwolf-vault-identity.service
    elif [ -d /run/openrc ] && command -v rc-service >/dev/null 2>&1; then
        if rc-service paintedwolf-vault-identity status >/dev/null 2>&1; then
            rc-service paintedwolf-vault-identity restart
        fi
    fi
    printf '%s\n' 'Quit and reopen a running Painted Wolf Code desktop after this upgrade before new credential operations.'
}

pre_remove() {
    printf '%s\n' 'After disabling the vault identity service, new or reopened app sessions cannot establish credential custody. A running app may retain its loaded key. Stored identities remain on disk; restore the service or reinstall before reopening.'
    if [ -d /run/systemd/system ]; then
        systemctl disable --now paintedwolf-vault-identity.socket
        systemctl stop paintedwolf-vault-identity.service
    elif [ -d /run/openrc ] && command -v rc-service >/dev/null 2>&1; then
        rc-service paintedwolf-vault-identity stop
        rc-update del paintedwolf-vault-identity default
    fi
}

post_remove() {
    _pw_refresh_desktop
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
    fi
}
