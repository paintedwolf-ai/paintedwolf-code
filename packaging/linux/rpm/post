# Register the package-authored units and refresh desktop caches; nothing else.
# $1 is 1 on first install and 2 or more on upgrade.
SOCKET_UNIT=paintedwolf-vault-identity.socket
SERVICE_UNIT=paintedwolf-vault-identity.service
if [ -f "/usr/lib/systemd/system/${SOCKET_UNIT}" ] && [ -d /run/systemd/system ]; then
  systemctl daemon-reload || :
  if [ "$1" -eq 1 ]; then
    systemctl enable --now "${SOCKET_UNIT}" || :
  elif [ "$1" -ge 2 ]; then
    # Restart an active instance without changing the administrator's enablement.
    systemctl try-restart "${SERVICE_UNIT}" || :
  fi
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || :
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f /usr/share/icons/hicolor/index.theme ]; then
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || :
fi
exit 0
