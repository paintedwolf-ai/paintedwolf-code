# Register the package-authored units and refresh desktop caches; nothing else.
SOCKET_UNIT=painted-wolf-code-identity.socket
if [ -f "/usr/lib/systemd/system/${SOCKET_UNIT}" ] && [ -d /run/systemd/system ]; then
  systemctl daemon-reload || :
  if [ -f /usr/lib/sysusers.d/painted-wolf-code.conf ] && command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers painted-wolf-code.conf || :
  fi
  systemctl enable --now "${SOCKET_UNIT}" || :
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || :
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f /usr/share/icons/hicolor/index.theme ]; then
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || :
fi
if [ -f /usr/share/selinux/packages/painted-wolf-code.pp ] && command -v semodule >/dev/null 2>&1 && command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then
  semodule -n -i /usr/share/selinux/packages/painted-wolf-code.pp || :
  if command -v load_policy >/dev/null 2>&1; then
    load_policy || :
  fi
  restorecon -R /opt/painted-wolf-code /usr/bin/pw /usr/bin/pw-logs /usr/bin/painted-wolf-code 2>/dev/null || :
fi
exit 0
