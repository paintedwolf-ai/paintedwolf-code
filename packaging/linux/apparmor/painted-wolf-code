# AppArmor profile for Painted Wolf Code.
#
# Ubuntu 24.04 and later restrict unprivileged user namespaces to programs
# whose profile grants them. The engine creates one for every confined
# command, so only the exact engine executable receives this grant. Bundled
# Git, browsers and other helpers launched directly retain the host restriction.
# The engine still builds the per-command namespace and syscall boundaries.
abi <abi/4.0>,

include <tunables/global>

profile painted-wolf-code /opt/painted-wolf-code/bin/pw flags=(unconfined) {
  userns,

  include if exists <local/painted-wolf-code>
}
