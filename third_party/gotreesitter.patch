+// The grammar requires a statement even in an empty script. Only parser-proven
+// comments and whitespace can establish the missing empty-program production.
+func normalizePowerShellCommentOnlyProgram(root *Node, source []byte, lang *Language) {
+	if root == nil || lang == nil || lang.Name != "powershell" || !root.hasError() {
+		return
+	}
+	program, ok := symbolByName(lang, "program")
+	if !ok {
+		return
+	}
+	var comments []*Node
+	cursor := uint32(0)
+	var collect func(*Node) bool
+	collect = func(node *Node) bool {
+		if node == nil || node.isMissing() || node.endByte > uint32(len(source)) {
+			return false
+		}
+		switch node.Type(lang) {
+		case "comment":
+			if node.hasError() || node.startByte < cursor || !bytesAreTrivia(source[cursor:node.startByte]) {
+				return false
+			}
+			comments = append(comments, node)
+			cursor = node.endByte
+			return true
+		case "program", "ERROR":
+			if len(node.children) == 0 {
+				return node.startByte <= node.endByte && bytesAreTrivia(source[node.startByte:node.endByte])
+			}
+			for _, child := range node.children {
+				if !collect(child) {
+					return false
+				}
+			}
+			return true
+		default:
+			return false
+		}
+	}
+	if !collect(root) || !bytesAreTrivia(source[cursor:]) {
+		return
+	}
+	root.children = cloneNodeSliceInArena(root.ownerArena, comments)
+	root.clearFieldMetadata()
+	retagResultRoot(root, program, symbolIsNamed(lang, program))
+	populateParentNode(root, root.children)
+	root.setHasError(false)
+	root.startByte, root.endByte = 0, uint32(len(source))
+	root.startPoint = Point{}
+	root.endPoint = advancePointByBytes(Point{}, source)
+}
