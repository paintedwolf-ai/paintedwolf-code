-		}
-	case bckQuote:
-		if p.backquoteEnd() {
-			break
-		}
-		fallthrough
-	case _Lit, dollBrace, dollDblParen, dollParen, dollar, cmdIn, assgnParen, cmdOut,
-		sglQuote, dollSglQuote, dblQuote, dollDblQuote, dollBrack,
-		globQuest, globStar, globPlus, globAt, globExcl:
