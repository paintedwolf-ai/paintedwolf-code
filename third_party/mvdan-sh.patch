-func walkNilable[N nilableNode](node N, f func(Node) bool) {
-	var zero N // nil
-	if node != zero {
-		Walk(node, f)
-	}
-}
-
-func walkList[N Node](list []N, f func(Node) bool) {
-	for _, node := range list {
