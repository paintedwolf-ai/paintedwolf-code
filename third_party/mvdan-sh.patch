-func isBashCompoundCommand(tok token, val string) bool {
-	switch tok {
-	case leftParen, dblLeftParen:
-		return true
-	case _LitWord:
-		switch val {
-		case "{", "if", "while", "until", "for", "case", "[[",
-			"coproc", "let", "function", "declare", "local",
-			"export", "readonly", "typeset", "nameref":
-			return true
-		}
-	}
-	return false
-}
