-				p.declClause(s)
-			}
-		case "time":
-			if p.lang.in(langBashLike | LangMirBSDKorn | LangZsh) {
-				p.timeClause(s)
-			}
-		case "coproc":
-			if p.lang.in(langBashLike) { // Note that mksh lacks this one.
-				p.coprocClause(s)
-			}
-		case "select":
-			if p.lang.in(langBashLike | LangMirBSDKorn | LangZsh) {
-				p.selectClause(s)
-			}
-		case "@test":
-			if p.lang.in(LangBats) {
-				p.testDecl(s)
-			}
-		}
-		if s.Cmd != nil {
