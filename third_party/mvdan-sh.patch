+func parsePath(tb testing.TB, path string) *File {
+	f, err := os.Open(path)
+	if err != nil {
+		tb.Fatal(err)
+	}
+	defer f.Close()
+	prog, err := NewParser(KeepComments(true)).Parse(f, "")
+	if err != nil {
+		tb.Fatal(err)
+	}
+	return prog
+}
