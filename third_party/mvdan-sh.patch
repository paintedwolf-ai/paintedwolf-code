+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			word := parseWord(t, tc.src)
+			got, err := Literal(tc.cfg, word)
+			if err != nil {
+				t.Fatalf("did not want error, got %v", err)
+			}
+			if got != tc.want {
+				t.Fatalf("wanted %q, got %q", tc.want, got)
+			}
+		})
+	}
