+		{
+			"a{1..4}",
+			[]string{"a1", "a2", "a3", "a4"},
+		},
+	}
+	for _, tc := range tests {
+		word := parseWord(t, tc.src)
+		for range 2 {
+			got, err := Fields(nil, word)
