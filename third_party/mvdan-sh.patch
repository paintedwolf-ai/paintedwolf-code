+error${/}parse-error.sh
+modify${/}dir${/}ext.sh
+modify${/}ext-shebang.sh
+modify${/}ext.bash
+modify${/}ext.bats
+modify${/}ext.mksh
+modify${/}ext.sh
+modify${/}ext.zsh
+modify${/}shebang-args
+modify${/}shebang-bash
+modify${/}shebang-bash.sh
+modify${/}shebang-dash
+modify${/}shebang-env-bash
+modify${/}shebang-env-bats
+modify${/}shebang-env-sh
+modify${/}shebang-mksh
+modify${/}shebang-sh
+modify${/}shebang-space
+modify${/}shebang-tabs
+modify${/}shebang-usr-sh
+modify${/}shebang-zsh
+-- modify.golden --
