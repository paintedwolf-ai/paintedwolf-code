-		end := posAddCol(s.Semicolon, 1) // ';' or '&'
-		if s.Coprocess || s.Disown {
-			end = posAddCol(end, 1) // '|&' or '&|' or '&!'
-		}
-		return end
-	}
-	end := s.Position
-	if s.Negated {
-		end = posAddCol(end, 1)
-	}
-	if s.Cmd != nil {
-		end = s.Cmd.End()
-	}
-	if len(s.Redirs) > 0 {
-		end = posMax(end, s.Redirs[len(s.Redirs)-1].End())
-	}
-	return end
-}
