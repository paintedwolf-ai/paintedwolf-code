+func TestConfigNils(t *testing.T) {
+	os.Setenv("EXPAND_GLOBAL", "value")
+	tests := []struct {
+		name string
+		cfg  *Config
+		src  string
+		want string
+	}{
+		{
+			"NilConfig",
+			nil,
+			"$EXPAND_GLOBAL",
+			"",
+		},
+		{
+			"ZeroConfig",
+			&Config{},
+			"$EXPAND_GLOBAL",
+			"",
+		},
+		{
+			"EnvConfig",
+			&Config{Env: ListEnviron(os.Environ()...)},
+			"$EXPAND_GLOBAL",
+			"value",
+		},
