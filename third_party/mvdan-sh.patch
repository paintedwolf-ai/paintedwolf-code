-		if p.tok == _EOF {
-			break
-		}
-		p.openNodes++
-		s := p.getStmt(true, false, false)
-		p.openNodes--
-		if s == nil {
-			p.invalidStmtStart()
-			break
-		}
-		gotEnd = s.Semicolon.IsValid()
-		if !yield(s, p.err) {
