-// TestDecl represents the declaration of a Bats test function.
-type TestDecl struct {
-	Position    Pos
-	Description *Word
-	Body        *Stmt
-}
-
-func (f *TestDecl) Pos() Pos { return f.Position }
-func (f *TestDecl) End() Pos { return f.Body.End() }
