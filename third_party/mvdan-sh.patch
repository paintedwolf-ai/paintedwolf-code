+func init() {
+	seenInputs := make(map[string]bool)
+	for i, c := range errorCases {
+		if seenInputs[c.in] {
+			panic(fmt.Sprintf("duplicate at %d: %q", i, c.in))
+		}
+		seenInputs[c.in] = true
+	}
+}
