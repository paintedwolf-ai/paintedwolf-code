+func allocationPool(t *testing.T, maximum int64) *syntax.AllocationBudget {
+	t.Helper()
+	pool, err := syntax.NewAllocationBudget(maximum)
+	if err != nil {
+		t.Fatalf("allocate fixture ledger: %v", err)
+	}
+	return pool
+}
