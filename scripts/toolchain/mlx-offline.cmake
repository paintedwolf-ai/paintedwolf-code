# This toolchain contributes source inputs only; target/platform selection stays
# with Cargo and cmake-rs. Other CMake consumers and non-Apple builds are unchanged.
if(NOT CMAKE_HOST_APPLE OR NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/mlx/c/array.h")
  return()
endif()
get_filename_component(_pw_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(DEFINED PW_MLX_VENDOR_ROOT)
  set(_pw_vendor "${PW_MLX_VENDOR_ROOT}")
else()
  set(_pw_vendor "${_pw_root}/third_party/mlx")
endif()
file(READ "${_pw_vendor}/pin.json" _pw_pin)
string(JSON _pw_sys_version GET "${_pw_pin}" mlx_sys_version)
get_filename_component(_pw_crate "${CMAKE_CURRENT_SOURCE_DIR}/../.." ABSOLUTE)
if(DEFINED PW_MLX_SYS_MANIFEST)
  file(READ "${PW_MLX_SYS_MANIFEST}" _pw_manifest)
else()
  file(READ "${_pw_crate}/Cargo.toml" _pw_manifest)
endif()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt" _pw_cmake)
string(REGEX MATCH "\\[package\\][^\\[]*" _pw_package "${_pw_manifest}")
string(REGEX MATCH "version[ \t]*=[ \t]*\"([^\"]+)\"" _pw_version "${_pw_package}")
if(NOT CMAKE_MATCH_1 STREQUAL _pw_sys_version)
  message(FATAL_ERROR "MLX_SOURCE_PIN_MISMATCH: update third_party/mlx/pin.json and its archives for mlx-sys")
endif()
string(JSON _pw_count LENGTH "${_pw_pin}" sources)
math(EXPR _pw_last "${_pw_count} - 1")
foreach(_pw_index RANGE ${_pw_last})
  foreach(_pw_field name archive sha256 directory tag)
    string(JSON _pw_${_pw_field} GET "${_pw_pin}" sources ${_pw_index} ${_pw_field})
  endforeach()
  string(FIND "${_pw_cmake}" "GIT_TAG ${_pw_tag})" _pw_tag_position)
  if(_pw_name STREQUAL "mlx" AND _pw_tag_position LESS 0)
    message(FATAL_ERROR "MLX_SOURCE_PIN_MISMATCH: update third_party/mlx/pin.json and its archives for the requested MLX tag")
  endif()
  set(_pw_archive_path "${_pw_vendor}/${_pw_archive}")
  if(NOT EXISTS "${_pw_archive_path}")
    message(FATAL_ERROR "MLX_SOURCE_MISSING: restore third_party/mlx/${_pw_archive}")
  endif()
  file(SHA256 "${_pw_archive_path}" _pw_observed)
  if(NOT _pw_observed STREQUAL _pw_sha256)
    message(FATAL_ERROR "MLX_SOURCE_DIGEST_MISMATCH: restore third_party/mlx/${_pw_archive} or update its reviewed pin")
  endif()
  set(_pw_extract "${CMAKE_BINARY_DIR}/paintedwolf-sources/${_pw_sha256}")
  if(NOT IS_DIRECTORY "${_pw_extract}/${_pw_directory}")
    file(ARCHIVE_EXTRACT INPUT "${_pw_archive_path}" DESTINATION "${_pw_extract}")
  endif()
  string(TOUPPER "${_pw_name}" _pw_upper)
  set(FETCHCONTENT_SOURCE_DIR_${_pw_upper} "${_pw_extract}/${_pw_directory}" CACHE PATH "Pinned offline source" FORCE)
endforeach()
set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL "Offline source inputs are required" FORCE)
set(FETCHCONTENT_UPDATES_DISCONNECTED ON CACHE BOOL "Offline source inputs are immutable" FORCE)
