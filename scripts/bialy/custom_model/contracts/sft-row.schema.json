{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pw-custom-sft/1",
  "title": "Host-accepted SFT row",
  "description": "One captured request, the response a student should emit and the host evidence that accepted it.",
  "type": "object",
  "required": [
    "schema",
    "session",
    "message_id",
    "prompt",
    "target",
    "request_capture",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "pw-custom-sft/1"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "array",
      "minItems": 1
    },
    "target": {
      "type": "object",
      "required": [
        "role",
        "text",
        "tool_calls"
      ],
      "properties": {
        "role": {
          "const": "assistant"
        },
        "text": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "arguments"
            ],
            "properties": {
              "arguments": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "request_capture": {
      "type": "object",
      "required": [
        "schema",
        "request_id",
        "session_id",
        "message_id",
        "host_revision",
        "epoch",
        "contract_sha256",
        "catalog_sha256",
        "student_provider",
        "student_kind",
        "student_model",
        "dispatch_sha256",
        "state_sha256",
        "messages",
        "tools",
        "controls",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "pw-model-request-capture/3"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "messages": {
          "type": "array",
          "minItems": 1
        },
        "tools": {
          "type": "array"
        },
        "controls": {
          "type": "object"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "schema",
        "validator",
        "receipt_id",
        "operation_ids",
        "request_sha256",
        "response_sha256",
        "kind",
        "outcome",
        "acceptance",
        "contract_sha256"
      ],
      "properties": {
        "schema": {
          "const": "pw-training-validation/1"
        },
        "validator": {
          "const": "paintedwolf-host-training-validation/1"
        },
        "operation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "enum": [
            "turn_committed",
            "operations"
          ]
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "bundle_sha256",
        "capture_sha256"
      ],
      "properties": {
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
