{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pw-training-candidate/1",
  "title": "Training candidate",
  "description": "One captured turn with the host facts the factory admits it on; it carries no admission decision. A capture the host excluded is a stub with its reason.",
  "type": "object",
  "required": [
    "schema",
    "session",
    "message_id",
    "call_id",
    "source"
  ],
  "properties": {
    "schema": {
      "const": "pw-training-candidate/1"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "call_id": {
      "type": "string"
    },
    "host_exclusion": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "array",
      "minItems": 1
    },
    "target": {
      "type": "object",
      "required": [
        "role",
        "text",
        "tool_calls"
      ],
      "properties": {
        "role": {
          "const": "assistant"
        },
        "text": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "arguments"
            ],
            "properties": {
              "arguments": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "request_capture": {
      "type": "object",
      "required": [
        "schema",
        "request_id",
        "session_id",
        "message_id",
        "host_revision",
        "epoch",
        "contract_sha256",
        "catalog_sha256",
        "student_provider",
        "student_kind",
        "student_model",
        "dispatch_sha256",
        "state_sha256",
        "messages",
        "tools",
        "controls",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "pw-model-request-capture/3"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "messages": {
          "type": "array",
          "minItems": 1
        },
        "tools": {
          "type": "array"
        },
        "controls": {
          "type": "object"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "receipt_id",
        "settled_at",
        "calls",
        "committed"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "call_id",
              "tool",
              "offered",
              "recorded"
            ],
            "properties": {
              "call_id": {
                "type": "string",
                "minLength": 1
              },
              "tool": {
                "type": "string",
                "minLength": 1
              },
              "offered": {
                "type": "boolean"
              },
              "recorded": {
                "type": "boolean"
              },
              "operation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "settlement": {
                "enum": [
                  "settled",
                  "unsettled"
                ]
              },
              "semantic_outcome": {
                "enum": [
                  "success",
                  "failure",
                  "unknown"
                ]
              },
              "effect_state": {
                "enum": [
                  "none",
                  "known",
                  "unknown"
                ]
              },
              "replays_unknown_effects": {
                "type": "boolean"
              }
            }
          }
        },
        "committed": {
          "type": "boolean"
        }
      }
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "bundle_sha256",
        "capture_sha256"
      ],
      "properties": {
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "host_exclusion"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "execution"
            ]
          }
        ]
      }
    },
    {
      "not": {
        "required": [
          "host_exclusion"
        ]
      },
      "required": [
        "prompt",
        "target",
        "request_capture",
        "execution",
        "response_sha256"
      ]
    }
  ]
}
