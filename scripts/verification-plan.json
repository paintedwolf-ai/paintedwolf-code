  "go": {
    "test:oar": {
      "options": [
        "--full"
      ],
      "packages": [
        "./internal/oarcore",
        "./internal/oar",
        "./internal/oarcopy",
        "./internal/guidance",
        "./internal/toolvocab",
        "./internal/catalogview",
        "./internal/tools"
      ]
    },
    "test:digest": {
      "options": [],
      "packages": [
        "./..."
      ],
      "report_all_failures": true
    },
    "test:short": {
      "options": [],
      "packages": [
        "./..."
      ],
      "exclude": "/test/(contract|integration|security|smoke|wiring)(/|$)",
      "report_all_failures": true
    },
    "test:wiring": {
      "options": [],
      "packages": [
        "./test/wiring/..."
      ]
    },
    "test:integration": {
      "options": [
        "--full",
        "--tags",
        "integration"
      ],
      "packages": [
        "./internal/...",
        "./test/integration/...",
        "./test/property/..."
      ]
    },
    "test:stress": {
      "options": [
        "--full",
        "--tags",
        "stress"
      ],
      "packages": [
        "./internal/db",
        "./internal/findings",
        "./internal/git",
        "./internal/sourcecatalog",
        "./internal/sourceledger",
        "./internal/session/store",
        "./internal/sourcecomparison",
        "./internal/tools/native/command",
        "./internal/toolhost",
        "./internal/tools/native/jq",
        "./internal/worker",
        "./internal/tools/native/mutation"
      ],
      "flags": [
        "-p=1",
        "-parallel=1",
        "-run=^TestStress"
      ]
    },
    "test:full": {
      "options": [
        "--full",
        "--tags",
        "integration"
      ],
      "packages": [
        "./..."
      ],
      "bundled": true
    },
    "test:contract": {
      "options": [],
      "packages": [
        "./test/contract/..."
      ],
      "exclude": "/test/contract/(runner|hosted|release)(/|$)",
      "report_all_failures": true
    },
    "test:security": {
      "options": [
        "--full",
        "--tags",
        "integration"
      ],
      "packages": [
        "./test/security/..."
      ]
    },
    "test:race": {
      "options": [
        "--full",
        "--race",
        "--tags",
        "integration"
      ],
      "packages": [
        "./..."
      ],
      "exclude": "/test/wiring/conformance$|/test/security/(scans|sweeps)$|/internal/launchguard$",
      "report_all_failures": true
    },
    "seatbelt:confine": {
      "options": [
        "--full"
      ],
      "packages": [
        "./internal/confine/...",
        "./internal/sandboxmark"
      ]
    },
    "seatbelt:gated": {
      "options": [
        "--full",
        "--tags",
        "integration"
      ],
      "packages": [
        "./cmd/opengrep-artifact",
        "./internal/app",
        "./internal/exec",
        "./internal/hitl",
        "./internal/layeredfs/adapter/platform",
        "./internal/layeredfs/adapter/viewconfine",
        "./internal/mcp",
        "./internal/programtest",
        "./internal/scan/drivers/bundled",
        "./internal/scan/drivers/external",
        "./internal/scan/installed",
        "./internal/scan/integration",
        "./internal/settings",
        "./internal/toolexecution",
        "./internal/tools/native",
        "./internal/tools/native/command",
        "./internal/webresearch",
        "./internal/worker",
        "./internal/workspace",
        "./test/contract/security",
        "./test/wiring/commands"
      ],
      "flags": [
        "-run=^(TestArtifactCLIRequiresConfinement|TestWithheldListenerRoutesToLocalListen|TestEngineLossFixtureProcess|TestLaunchPlanRefusesUnavailableLinuxBoundary|TestNonHTTPContractContainedDerivesFromSameRequestAsProfile|TestNonHTTPContractProxyStartupFailureDeniesAndRollsBack|TestPrepareStdioCommandConfinedWhenAvailable|TestPrepareStdioCommandHandsTheServerNoCredential|TestPrepareStdioCommandRequiresRootsWhenAvailable|TestContainedPreservesReadOnlyRootAuthority|TestBundledScannerConfinementDeniesNetwork|TestExternalScannerWritesProjectTree|TestContainedCarriesDirectIPNarrowing|TestContainedProvenanceMatchesDefaultConfinement|TestContainedTaskOverlayStaysOutOfRoots|TestContainedWriteRootsCarryDurableGrants|TestExternalScannerLaunchIsValidWhileEnforcing|TestWebToolsUnaffectedByCommandProxyOnlyDefault|TestOpenGrepBundledAdapterFixture|TestIngesterBundledSASTProducesGuidance|TestOpenGrepScopesExcludesToProjectNotAncestorDirectories|TestOpenGrepEmbeddedSourceRecovery|TestCommandInstructionGrantUsesOneOrdinaryApproval|TestCurrentReviewCannotReplaceExecutionPermit|TestExecutionCapabilityAsksBeforeSpawnAndConsumesOnce|TestExecutionReviewHonorsReviewedReasonAndLaterDeny|TestInstalledScannerProductCases|TestSelectedScannerCannotQualifyAnEmptySuccessfulReport|TestSessionOutputReadUsesAppliedReadOnlyAuthority|TestPreparedGroupRefusesRemovedCaptureAfterOwnerRegistration|TestPreparedLaunchFreezesFinalPathEnvironmentAndLiteralArguments|TestPreparedLaunchPreservesRelativeScriptKernelFilename|TestPreparedLaunchRegistersBeforePayloadAndRechecksCurrentAuthority|TestPreparedLaunchRejectsChangedCapturedVectorsBeforeNativeStart|TestPreparedLaunchResolvesRelativeAndEmptyPathAtCapturedCwd|TestPreparedLinuxBinaryPreservesNativePathArgvCwdAndExecuteOnlyMode|TestPreparedLinuxScriptPreservesOrdinaryPathAndNativeArgv|TestPreparedNativeCallbackFailureAndCancellationNeverReleasePayload|TestPreparedStrictBoundaryNeverFallsBackToHostExecution|TestOwnedProcessGroupCancellationRetainsNativeSettlement|TestOwnedProcessGroupRefusesConsumedPreparedCommand|TestOwnedProcessGroupWaitsOnceStopsTreeAndPreservesUnrelatedProcess|TestPinnedLaunchDoesNotGrantAnUnadmittedHardlinkOperand|TestPinnedLaunchPreservesOrdinaryScriptArgumentsAndDirectory|TestPinnedLaunchRefusesChangedEntryAndRevokedAdmissionBeforePayload|TestPinnedHostExecutionPreservesSetuidProcessInspection|TestRunInOwnGroupCancellationKillsAShellIgnoringTerm|TestRunInOwnGroupDetachesFromTheEnginesTerminal|TestRunInOwnGroupEndsWhatTheCommandLeftBehind|TestRunInOwnGroupReportsACommandRemovedAfterPreparation|TestRunInOwnGroupTerminalHelperProcess|TestNonHTTPContractStaleSymlinkGrantRevalidateDenies|TestNativeCommandFileInputsCarryBytesWithoutSourceMetadata|TestExternalCommandSaveMergesWithHumanTyping|TestProgramAppendStopsOnUnsavedAcceptanceWithoutReplaying|TestProgramPublicationRedirectEffectsAdmitBeforeOpening|TestProgramPublicationRedirectRequiresCurrentWriteProgress|TestProgramPublicationRespectsCurrentEffectAuthority|TestProgramPublicationReviewRaceStopsBeforeRead|TestProgramPublicationSettlesBeforeRedirectCapture|TestProgramPublishesOwnAgentDraftBeforeNativeAndExternalReads|TestRetainedCommandOutputCreditsOnlyDeliveredHeadAndTail|TestEveryTerminalResultStatesTheBox|TestTerminalAndCommandShareLaunchEnvironmentAndScratch|TestProgramExternalSystemToolsRunWithoutStderr|TestProgramExternalOutsideWriteRefusedWhileTempWriteAllowed|TestExternalSpawnUsesOnlyAdmittedWriteRoots|TestAgentGitAuthenticatesFromInsideItsConfinement|TestAgentGitReachesTheGrantedSSHAgentFromInsideItsConfinement|TestRealEnforcerSelectsAndVerifiesAMountedView|TestAvailabilityIsProvenByARealDenialAndLeavesNothing|TestDeniedPathNamedThroughAnAliasIsRefusedAtItsCanonicalPath|TestLaunchRefusesAProcessThatAnswersTooFewSteps|TestPlacedBranchIsUsableAndItsFolderIsClosed|TestMaterializedWorkerReachesOnlyItsOwnBranch|TestOrdinaryWorkerClaimThroughARealMountedViewToCompletion|TestBranchTreeAnswersFromTheViewOnEveryProvider|TestNonPrimaryRootRefsReachPromotionAndRollBack|TestSmallMaterializedLifecycleAcrossProcessRestart|TestSmallMaterializedLifecyclePreservesSourceConflict|TestSmallMountedLifecycleAcrossProcessRestart|TestSmallMountedLifecyclePreservesSourceConflict|TestStackedWorkerClaimsAndPromotesThroughTheOneTransaction|TestRefusedOperationsLeaveTheWorldUnchanged|TestRefusedPathsStayInsideTheRoots|TestGateContainedIsTheAppliedSpawnBoundary|TestSpawnRefusesASocketTheBoundaryLacks|TestContractNoAmbientNetworkAllowAlias|TestInvariantWriteRootSSOTSharedByGateAndConfine|TestProgramBackgroundReadServesThePersonsDraft|TestProgramReadsThePersonsUnsavedText|TestProgramWriteSavesThePersonsDraftWithIt|TestProgramRepoMapReadsThePersonsDraft)$"
      ],
      "bundled": true
    },
    "seatbelt:scanstress": {
      "options": [
        "--full",
        "--tags",
        "scanstress"
      ],
      "packages": [
        "./test/scanstress/..."
