{
  "groups": {
    "default": [
      "check-fast"
    ],
    "check-fast": [
      "build",
      "lint:fast",
      "den:typecheck",
      "den:lint",
      "den:test:fast",
      "test:short"
    ],
    "oar:verify": [
      "test:oar",
      "oar:conformance"
    ],
    "check": [
      "build",
      "build:cross",
      "check:drift",
      "openapi:lint",
      "validate:workflows",
      "oar:verify",
      "check:tests",
      "test:fail-messages:check",
      "comments:check",
      "lint:full",
      "lint:vuln"
    ],
    "check:tests": [
      "test:runner",
      "test:full",
      "den:typecheck",
      "den:lint",
      "den:test",
      "den:test:rust",
      "den:webkit:scroll"
    ],
    "check:drift": [
      "codegen:wire-enums:check",
      "codegen:web-research-catalog:check",
      "codegen:contribution-facts:check",
      "codegen:contribution-inventory:check",
      "codegen:theme-tokens:check",
      "codegen:dependency-inventory:check",
      "codegen:den-fonts:check",
      "codegen:client-notices:check",
      "codegen:host-markers:check",
      "codegen:detection-packs:check",
      "openapi:bundle:check",
      "codegen:tool-command-equivalence:check",
      "codegen:guidance-registry:check",
      "oar:vendor:check",
      "scan:rules:vendor:check",
      "secret-mint:vendor:check",
      "lint:vuln:vendor:check",
      "codegen:native-tool-contracts:check",
      "codegen:worker-branch-tools:check",
      "codegen:approval-explanations:check",
      "codegen:tool-presentation:check",
      "codegen:den-types:check",
      "db:sqlc:check",
      "db:sqlc:vet",
      "docs:links"
    ]
  },
  "go": {
    "test:oar": {
      "options": [
        "--full"
      ],
      "packages": [
        "./internal/oarcore",
        "./internal/oar",
        "./internal/oarcopy",
        "./internal/guidance",
        "./internal/toolvocab",
        "./internal/catalogview",
        "./internal/tools"
      ]
    },
    "test:digest": {
      "options": [],
      "packages": [
        "./..."
      ]
    },
    "test:short": {
      "options": [],
      "packages": [
        "./..."
      ],
      "exclude": "/test/(contract|integration|security|smoke|wiring)(/|$)"
    },
    "test:wiring": {
      "options": [],
      "packages": [
        "./test/wiring/..."
      ]
    },
    "test:integration": {
      "options": [
        "--full",
        "--tags",
        "integration"
      ],
      "packages": [
        "./internal/...",
        "./test/integration/...",
        "./test/property/..."
      ]
    },
    "test:stress": {
      "options": [
        "--full",
        "--tags",
        "stress",
        "--timeout",
        "90m"
      ],
      "packages": [
        "./internal/db",
        "./internal/findings",
        "./internal/git",
        "./internal/sourcecatalog",
        "./internal/sourceledger",
        "./internal/session/store",
        "./internal/sourcecomparison"
      ],
      "flags": [
        "-p=1",
        "-parallel=1",
        "-run=^TestStress"
      ]
    },
    "test:full": {
      "options": [
        "--full",
        "--tags",
        "integration",
        "--timeout",
        "40m"
      ],
      "packages": [
        "./..."
      ],
      "bundled": true
    },
    "test:contract": {
      "options": [
        "--timeout",
        "15m"
      ],
      "packages": [
        "./test/contract/..."
      ]
    },
    "test:security": {
      "options": [
        "--full",
        "--timeout",
        "40m"
      ],
      "packages": [
        "./test/security/..."
      ]
    },
    "test:race": {
      "options": [
        "--full",
        "--race",
        "--tags",
        "integration",
        "--timeout",
        "40m"
      ],
      "packages": [
        "./..."
      ],
      "exclude": "/test/security$"
    }
  },
