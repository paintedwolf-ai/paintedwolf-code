  "ci": {
    "build": {
      "targets": [
        "build",
        "build:cross"
      ],
      "minutes": 120,
      "profiles": [
        "check",
        "release"
      ],
      "suite": "all",
      "native": false
    },
    "contracts": {
      "targets": [
        "check:drift",
        "openapi:lint",
        "validate:workflows",
        "oar:verify"
      ],
      "minutes": 120,
      "profiles": [
        "check",
        "release"
      ],
      "suite": "all",
      "native": false
    },
    "lint": {
      "targets": [
        "lint:full",
        "test:fail-messages:check",
        "comments:check"
      ],
      "minutes": 90,
      "profiles": [
        "check"
      ],
      "suite": "all",
      "native": false
    },
    "vulnerabilities": {
      "targets": [
        "lint:vuln"
      ],
      "minutes": 240,
      "profiles": [
        "check",
        "release"
      ],
      "suite": "all",
      "native": false
    },
    "runner": {
      "targets": [
        "test:runner"
      ],
      "minutes": 60,
      "profiles": [
        "check"
      ],
      "suite": "all",
      "native": false
    },
    "behavior": {
      "targets": [
        "test:full"
      ],
      "minutes": 150,
      "profiles": [
        "check",
        "release",
        "nightly"
      ],
      "suite": "behavior",
      "native": false
    },
    "frontend": {
      "targets": [
        "den:typecheck",
        "den:lint",
        "den:test"
      ],
      "minutes": 90,
      "profiles": [
        "check",
        "release"
      ],
      "suite": "all",
      "native": false
    },
    "native": {
      "targets": [
        "den:test:rust"
      ],
      "minutes": 90,
      "profiles": [
        "check",
        "release"
      ],
      "suite": "all",
      "native": true
    },
    "webkit": {
      "targets": [
        "den:webkit:scroll"
      ],
      "minutes": 120,
      "profiles": [
        "check"
      ],
      "suite": "all",
      "native": true,
      "runner": "macos-15"
    },
    "race": {
      "targets": [
        "test:race"
      ],
      "minutes": 300,
      "profiles": [
        "nightly"
      ],
      "suite": "race",
      "native": false
    },
    "fuzz": {
      "targets": [
        "test:fuzz"
      ],
      "minutes": 180,
      "profiles": [
        "nightly"
      ],
      "suite": "fuzz",
      "native": false
    },
    "stress": {
      "targets": [
        "test:stress"
      ],
      "minutes": 180,
      "profiles": [
        "nightly"
      ],
      "suite": "performance",
      "native": false
    },
    "go-coverage": {
      "targets": [
        "check:coverage"
      ],
