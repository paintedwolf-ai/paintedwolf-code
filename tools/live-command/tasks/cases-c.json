[
  {"label": "c01-devnull", "command": "ls nonexistent 2>/dev/null"},
  {"label": "c02-2to1", "command": "ls nonexistent 2>&1"},
  {"label": "c03-test-f", "command": "test -f go.mod && ls go.mod"},
  {"label": "c04-bracket-d", "command": "[ -d internal ] && ls internal"},
  {"label": "c05-dbl-bracket", "command": "[[ -f main.go ]] && wc -l main.go"},
  {"label": "c06-touch", "command": "touch newfile.txt && ls newfile.txt"},
  {"label": "c07-git-status", "command": "git status --short"},
  {"label": "c08-git-log", "command": "git log --oneline -3"},
  {"label": "c09-sleep-fg", "command": "sleep 1"},
  {"label": "c10-bg-external", "command": "external -- sleep 20 &\njobs"},
  {"label": "c11-bg-kill", "command": "external -- sleep 20 &\njobs\nkill %1\nwait %1\njobs"},
  {"label": "c12-parent-cat", "command": "cat ../pw.py | head -2"},
  {"label": "c13-parent-cp-out", "command": "cp README.txt ../escaped-readme.txt && ls .."},
  {"label": "c14-abs-in-project", "command": "cat \"$PWD/go.mod\""},
  {"label": "c15-overwrite-redirect", "command": "cat README.txt > copy.txt && cat main.go > copy.txt && wc -c copy.txt"},
  {"label": "c16-append", "command": "cat go.mod >> copy.txt && wc -c copy.txt"},
  {"label": "c17-heredoc-overwrite-existing", "command": "cat > docs/nested/list.txt <<'EOF'\none\ntwo\nEOF\ncat docs/nested/list.txt"},
  {"label": "c18-pwd-abs", "command": "cd internal/calc && pwd"},
  {"label": "c19-true-false", "command": "true && false || ls go.mod"},
  {"label": "c20-status-var", "command": "ls nonexistent; ls -d \"status-$?\" 2>&1"},
  {"label": "c21-for-glob", "command": "for f in internal/*/*_test.go; do wc -l \"$f\"; done"},
  {"label": "c22-cmd-subst", "command": "wc -l $(ls *.go)"},
  {"label": "c23-nested-pipe", "command": "cat main.go | head -5 | tail -2"},
  {"label": "c24-external-go-vet", "command": "go vet ./..."},
  {"label": "c25-tee-progress", "command": "cat go.mod | tee tee-out.txt"},
  {"label": "c26-mkdir-redirect", "command": "mkdir -p out/deep && cat go.mod > out/deep/g.txt && cat out/deep/g.txt"},
  {"label": "c27-env-var-external", "command": "FOO=bar external -- env"},
  {"label": "c28-chmod", "command": "chmod +x main.go && ls -l main.go"}
]
