[
  {"label": "m01-echo", "command": "echo hello world"},
  {"label": "m02-ls", "command": "ls -la"},
  {"label": "m03-pwd-cd", "command": "pwd; cd internal && pwd && ls"},
  {"label": "m04-cat", "command": "cat config.json"},
  {"label": "m05-find-go", "command": "find . -name '*.go' -type f"},
  {"label": "m06-find-wc-pipe", "command": "find . -name '*.go' | xargs wc -l | sort -n"},
  {"label": "m07-glob-wc", "command": "wc -l *.go internal/*/*.go cmd/tool/*.go"},
  {"label": "m08-loop", "command": "for f in $(find . -name '*.go'); do echo \"$f $(wc -l < $f)\"; done | sort -k2 -n | tail -1"},
  {"label": "m09-grep-todo", "command": "grep -rn TODO ."},
  {"label": "m10-grep-include", "command": "grep -rn --include='*.go' TODO ."},
  {"label": "m11-rg", "command": "rg -n TODO"},
  {"label": "m12-head-tail", "command": "head -n 3 main.go; tail -n 2 README.txt"},
  {"label": "m13-redirect-new", "command": "grep -rn TODO --include='*.go' . > notes.txt; cat notes.txt"},
  {"label": "m14-append", "command": "echo 'extra line' >> notes.txt && wc -l notes.txt"},
  {"label": "m15-heredoc", "command": "cat > hello.txt <<'EOF'\nline one\nline two\nEOF\ncat hello.txt"},
  {"label": "m16-jq-read", "command": "jq '.name' config.json"},
  {"label": "m17-jq-rename", "command": "jq '.y = .x | del(.x)' config.json > config.json.tmp && mv config.json.tmp config.json && cat config.json"},
  {"label": "m18-sed-inplace", "command": "sed -i '' 's/alpha/ALPHA/' docs/nested/list.txt && cat docs/nested/list.txt"},
  {"label": "m19-sed-inplace-gnu", "command": "sed -i 's/beta/BETA/' docs/nested/list.txt && cat docs/nested/list.txt"},
  {"label": "m20-go-test", "command": "go test ./..."},
  {"label": "m21-go-test-status", "command": "go test ./... ; echo \"exit=$?\""},
  {"label": "m22-go-test-pipe", "command": "go test ./... 2>&1 | grep -E 'FAIL|ok'"},
  {"label": "m23-external-explicit", "command": "external -- go version"},
  {"label": "m24-git-status", "command": "git status --short && git log --oneline -1"},
  {"label": "m25-bg-job", "command": "sleep 30 &\njobs"},
  {"label": "m26-kill-job", "command": "sleep 30 &\nkill %1\nwait\necho \"waited status=$?\""},
  {"label": "m27-outside-read", "command": "cat /etc/hosts | head -3"},
  {"label": "m28-outside-write", "command": "echo pwned > /tmp/pw-live-sanity-outside.txt"},
  {"label": "m29-parent-traverse", "command": "ls ../"},
  {"label": "m30-rm", "command": "rm hello.txt && ls"},
  {"label": "m31-test-bracket", "command": "if [ -f go.mod ]; then echo has-mod; fi; [[ -d internal ]] && echo has-internal"},
  {"label": "m32-vars-arith", "command": "n=0; for f in *.go internal/*/*.go; do n=$((n+1)); done; echo $n"},
  {"label": "m33-2>&1", "command": "ls nonexistent 2>&1; echo status=$?"},
  {"label": "m34-dev-null", "command": "ls nonexistent 2>/dev/null || echo missing"},
  {"label": "m35-awk", "command": "awk '{print NR\": \"$0}' docs/nested/list.txt"},
  {"label": "m36-cut-sort-uniq", "command": "grep -rn TODO . | cut -d: -f1 | sort | uniq -c"},
  {"label": "m37-mkdir-touch", "command": "mkdir -p tmp/a/b && touch tmp/a/b/x.txt && find tmp"},
  {"label": "m38-cp-mv", "command": "cp README.txt tmp/readme.copy && mv tmp/readme.copy tmp/readme.moved && ls tmp"},
  {"label": "m39-python", "command": "python3 -c 'print(1+1)'"},
  {"label": "m40-bash-c", "command": "bash -c 'echo from bash'"},
  {"label": "m41-export-env", "command": "export FOO=bar; echo $FOO; env | grep FOO"},
  {"label": "m42-command-v", "command": "command -v go; which jq; type grep"},
  {"label": "m43-set-e", "command": "set -euo pipefail; echo ok"},
  {"label": "m44-subshell", "command": "(cd internal/calc && ls)"},
  {"label": "m45-xargs-grep", "command": "find . -name '*.go' | xargs grep -l TODO"},
  {"label": "m46-tee", "command": "echo teed | tee tmp/tee.txt"},
  {"label": "m47-printf", "command": "printf '%s=%d\\n' a 1 b 2"},
  {"label": "m48-func", "command": "count() { wc -l < \"$1\"; }; count main.go"},
  {"label": "m49-while-read", "command": "while read -r line; do echo \"got $line\"; done < docs/nested/list.txt"},
  {"label": "m50-diff", "command": "diff README.txt README.txt && echo same"},
  {"label": "m51-go-build-out", "command": "go build -o tmp/sanity . && ./tmp/sanity"},
  {"label": "m52-go-run", "command": "go run ./cmd/tool"},
  {"label": "m53-git-diff", "command": "git diff --stat"},
  {"label": "m54-stat", "command": "stat -f '%z %N' main.go"},
  {"label": "m55-edit-tool", "command": "edit --help"}
]
